{"parents": [{"link": "../", "title": "Bound Methods"}], "prev": {"link": "../Message.click/", "title": "Message.click()"}, "next": {"link": "../Message.download/", "title": "Message.download()"}, "title": "Message.delete()", "meta": null, "body": "<section id=\"message-delete\">\n<h1>Message.delete()<a class=\"headerlink\" href=\"#message-delete\" title=\"Link to this heading\">\u00b6</a></h1>\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.types.Message.delete\">\n<span class=\"sig-prename descclassname\"><span class=\"pre\">Message.</span></span><span class=\"sig-name descname\"><span class=\"pre\">delete</span></span><span class=\"sig-paren\">(</span><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#pyrogram.types.Message.delete\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Bound method <em>delete</em> of <a class=\"reference internal\" href=\"../../types/Message/#pyrogram.types.Message\" title=\"pyrogram.types.Message\"><code class=\"xref py py-obj docutils literal notranslate\"><span class=\"pre\">Message</span></code></a>.</p>\n<p>Use as a shortcut for:</p>\n<div class=\"highlight-python notranslate\"><div class=\"highlight\"><pre><span></span><span class=\"k\">await</span> <span class=\"n\">client</span><span class=\"o\">.</span><span class=\"n\">delete_messages</span><span class=\"p\">(</span>\n    <span class=\"n\">chat_id</span><span class=\"o\">=</span><span class=\"n\">chat_id</span><span class=\"p\">,</span>\n    <span class=\"n\">message_ids</span><span class=\"o\">=</span><span class=\"n\">message</span><span class=\"o\">.</span><span class=\"n\">id</span>\n<span class=\"p\">)</span>\n</pre></div>\n</div>\n<p class=\"rubric\">Example</p>\n<div class=\"highlight-python notranslate\"><div class=\"highlight\"><pre><span></span><span class=\"k\">await</span> <span class=\"n\">message</span><span class=\"o\">.</span><span class=\"n\">delete</span><span class=\"p\">()</span>\n</pre></div>\n</div>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p><strong>revoke</strong> (<code class=\"docutils literal notranslate\"><span class=\"pre\">bool</span></code>, <em>optional</em>) \u2013 Deletes messages on both parts.\nThis is only for private cloud chats and normal groups, messages on\nchannels and supergroups are always revoked (i.e.: deleted for everyone).\nDefaults to True.</p>\n</dd>\n<dt class=\"field-even\">Returns<span class=\"colon\">:</span></dt>\n<dd class=\"field-even\"><p><code class=\"docutils literal notranslate\"><span class=\"pre\">int</span></code> \u2013 Amount of affected messages</p>\n</dd>\n<dt class=\"field-odd\">Raises<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p><strong>RPCError</strong> \u2013 In case of a Telegram RPC error.</p>\n</dd>\n</dl>\n</dd></dl>\n\n</section>\n", "metatags": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n", "rellinks": [["genindex", "General Index", "I", "index"], ["py-modindex", "Python Module Index", "", "modules"], ["api/bound-methods/Message.download", "Message.download()", "N", "next"], ["api/bound-methods/Message.click", "Message.click()", "P", "previous"]], "sourcename": "", "toc": "<ul>\n<li><a class=\"reference internal\" href=\"#\">Message.delete()</a><ul>\n<li><a class=\"reference internal\" href=\"#pyrogram.types.Message.delete\"><code class=\"docutils literal notranslate\"><span class=\"pre\">Message.delete()</span></code></a></li>\n</ul>\n</li>\n</ul>\n", "display_toc": true, "page_source_suffix": ".rst", "current_page_name": "api/bound-methods/Message.delete", "sidebars": ["sidebar/brand.html", "sidebar/search.html", "sidebar/scroll-start.html", "sidebar/navigation.html", "sidebar/scroll-end.html"], "alabaster_version": "1.0.0", "alabaster_version_info": [1, 0, 0], "furo_version": "2025.12.19", "furo_navigation_tree": "", "furo_hide_toc": false, "furo_pygments": {"light": {"background": "#eeffcc", "foreground": "black"}, "dark": {"background": "#202020", "foreground": "#d0d0d0"}}}