{"parents": [{"link": "../", "title": "Bound Methods"}], "prev": {"link": "../Message.pin/", "title": "Message.pin()"}, "next": {"link": "../Message.edit/", "title": "Message.edit()"}, "title": "Message.unpin()", "meta": null, "body": "<section id=\"message-unpin\">\n<h1>Message.unpin()<a class=\"headerlink\" href=\"#message-unpin\" title=\"Link to this heading\">\u00b6</a></h1>\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.types.Message.unpin\">\n<span class=\"sig-prename descclassname\"><span class=\"pre\">Message.</span></span><span class=\"sig-name descname\"><span class=\"pre\">unpin</span></span><span class=\"sig-paren\">(</span><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#pyrogram.types.Message.unpin\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Bound method <em>unpin</em> of <a class=\"reference internal\" href=\"../../types/Message/#pyrogram.types.Message\" title=\"pyrogram.types.Message\"><code class=\"xref py py-obj docutils literal notranslate\"><span class=\"pre\">Message</span></code></a>.</p>\n<p>Use as a shortcut for:</p>\n<div class=\"highlight-python notranslate\"><div class=\"highlight\"><pre><span></span><span class=\"k\">await</span> <span class=\"n\">client</span><span class=\"o\">.</span><span class=\"n\">unpin_chat_message</span><span class=\"p\">(</span>\n    <span class=\"n\">chat_id</span><span class=\"o\">=</span><span class=\"n\">message</span><span class=\"o\">.</span><span class=\"n\">chat</span><span class=\"o\">.</span><span class=\"n\">id</span><span class=\"p\">,</span>\n    <span class=\"n\">message_id</span><span class=\"o\">=</span><span class=\"n\">message_id</span>\n<span class=\"p\">)</span>\n</pre></div>\n</div>\n<p class=\"rubric\">Example</p>\n<div class=\"highlight-python notranslate\"><div class=\"highlight\"><pre><span></span><span class=\"k\">await</span> <span class=\"n\">message</span><span class=\"o\">.</span><span class=\"n\">unpin</span><span class=\"p\">()</span>\n</pre></div>\n</div>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Returns<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p>True on success.</p>\n</dd>\n<dt class=\"field-even\">Raises<span class=\"colon\">:</span></dt>\n<dd class=\"field-even\"><p><strong>RPCError</strong> \u2013 In case of a Telegram RPC error.</p>\n</dd>\n</dl>\n</dd></dl>\n\n</section>\n", "metatags": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n", "rellinks": [["genindex", "General Index", "I", "index"], ["py-modindex", "Python Module Index", "", "modules"], ["api/bound-methods/Message.edit", "Message.edit()", "N", "next"], ["api/bound-methods/Message.pin", "Message.pin()", "P", "previous"]], "sourcename": "", "toc": "<ul>\n<li><a class=\"reference internal\" href=\"#\">Message.unpin()</a><ul>\n<li><a class=\"reference internal\" href=\"#pyrogram.types.Message.unpin\"><code class=\"docutils literal notranslate\"><span class=\"pre\">Message.unpin()</span></code></a></li>\n</ul>\n</li>\n</ul>\n", "display_toc": true, "page_source_suffix": ".rst", "current_page_name": "api/bound-methods/Message.unpin", "sidebars": ["sidebar/brand.html", "sidebar/search.html", "sidebar/scroll-start.html", "sidebar/navigation.html", "sidebar/scroll-end.html"], "alabaster_version": "1.0.0", "alabaster_version_info": [1, 0, 0], "furo_version": "2025.12.19", "furo_navigation_tree": "", "furo_hide_toc": false, "furo_pygments": {"light": {"background": "#eeffcc", "foreground": "black"}, "dark": {"background": "#202020", "foreground": "#d0d0d0"}}}