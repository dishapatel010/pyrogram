{"parents": [{"link": "../", "title": "Enumerations"}], "prev": {"link": "../ChatMembersFilter/", "title": "ChatMembersFilter"}, "next": {"link": "../ChatJoinType/", "title": "ChatJoinType"}, "title": "ChatType", "meta": null, "body": "<section id=\"chattype\">\n<h1>ChatType<a class=\"headerlink\" href=\"#chattype\" title=\"Link to this heading\">\u00b6</a></h1>\n<dl class=\"py class\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.enums.ChatType\">\n<em class=\"property\"><span class=\"pre\">class</span><span class=\"w\"> </span></em><span class=\"sig-prename descclassname\"><span class=\"pre\">pyrogram.enums.</span></span><span class=\"sig-name descname\"><span class=\"pre\">ChatType</span></span><a class=\"headerlink\" href=\"#pyrogram.enums.ChatType\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Chat type enumeration used in <a class=\"reference internal\" href=\"../../types/Chat/#pyrogram.types.Chat\" title=\"pyrogram.types.Chat\"><code class=\"xref py py-obj docutils literal notranslate\"><span class=\"pre\">Chat</span></code></a>.</p>\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.enums.ChatType.PRIVATE\">\n<span class=\"sig-name descname\"><span class=\"pre\">PRIVATE</span></span><em class=\"property\"><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">=</span></span><span class=\"w\"> </span><span class=\"pre\">'private'</span></em><a class=\"headerlink\" href=\"#pyrogram.enums.ChatType.PRIVATE\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Chat is a private chat with a user</p>\n</dd></dl>\n\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.enums.ChatType.BOT\">\n<span class=\"sig-name descname\"><span class=\"pre\">BOT</span></span><em class=\"property\"><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">=</span></span><span class=\"w\"> </span><span class=\"pre\">'bot'</span></em><a class=\"headerlink\" href=\"#pyrogram.enums.ChatType.BOT\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Chat is a private chat with a bot</p>\n</dd></dl>\n\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.enums.ChatType.GROUP\">\n<span class=\"sig-name descname\"><span class=\"pre\">GROUP</span></span><em class=\"property\"><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">=</span></span><span class=\"w\"> </span><span class=\"pre\">'group'</span></em><a class=\"headerlink\" href=\"#pyrogram.enums.ChatType.GROUP\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Chat is a group</p>\n</dd></dl>\n\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.enums.ChatType.SUPERGROUP\">\n<span class=\"sig-name descname\"><span class=\"pre\">SUPERGROUP</span></span><em class=\"property\"><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">=</span></span><span class=\"w\"> </span><span class=\"pre\">'supergroup'</span></em><a class=\"headerlink\" href=\"#pyrogram.enums.ChatType.SUPERGROUP\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Chat is a supergroup</p>\n</dd></dl>\n\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.enums.ChatType.CHANNEL\">\n<span class=\"sig-name descname\"><span class=\"pre\">CHANNEL</span></span><em class=\"property\"><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">=</span></span><span class=\"w\"> </span><span class=\"pre\">'channel'</span></em><a class=\"headerlink\" href=\"#pyrogram.enums.ChatType.CHANNEL\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Chat is a channel</p>\n</dd></dl>\n\n</dd></dl>\n\n<script>\n  document\n    .querySelectorAll(\"em.property\")\n    .forEach((elem, i) => i !== 0 ? elem.remove() : true)\n  document\n    .querySelectorAll(\"a.headerlink\")\n    .forEach((elem, i) => [0, 1].includes(i) ? true : elem.remove())\n</script></section>\n", "metatags": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\