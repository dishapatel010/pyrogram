{"parents": [{"link": "../", "title": "Enumerations"}], "prev": {"link": "../ChatJoinType/", "title": "ChatJoinType"}, "next": {"link": "../MessageEntityType/", "title": "MessageEntityType"}, "title": "ClientPlatform", "meta": null, "body": "<section id=\"clientplatform\">\n<h1>ClientPlatform<a class=\"headerlink\" href=\"#clientplatform\" title=\"Link to this heading\">\u00b6</a></h1>\n<dl class=\"py class\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.enums.ClientPlatform\">\n<em class=\"property\"><span class=\"pre\">class</span><span class=\"w\"> </span></em><span class=\"sig-prename descclassname\"><span class=\"pre\">pyrogram.enums.</span></span><span class=\"sig-name descname\"><span class=\"pre\">ClientPlatform</span></span><a class=\"headerlink\" href=\"#pyrogram.enums.ClientPlatform\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Valid platforms for a <a class=\"reference internal\" href=\"../../client/#pyrogram.Client\" title=\"pyrogram.Client\"><code class=\"xref py py-obj docutils literal notranslate\"><span class=\"pre\">Client</span></code></a>.</p>\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.enums.ClientPlatform.ANDROID\">\n<span class=\"sig-name descname\"><span class=\"pre\">ANDROID</span></span><em class=\"property\"><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">=</span></span><span class=\"w\"> </span><span class=\"pre\">'android'</span></em><a class=\"headerlink\" href=\"#pyrogram.enums.ClientPlatform.ANDROID\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Android</p>\n</dd></dl>\n\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.enums.ClientPlatform.IOS\">\n<span class=\"sig-name descname\"><span class=\"pre\">IOS</span></span><em class=\"property\"><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">=</span></span><span class=\"w\"> </span><span class=\"pre\">'ios'</span></em><a class=\"headerlink\" href=\"#pyrogram.enums.ClientPlatform.IOS\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>iOS</p>\n</dd></dl>\n\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.enums.ClientPlatform.WP\">\n<span class=\"sig-name descname\"><span class=\"pre\">WP</span></span><em class=\"property\"><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">=</span></span><span class=\"w\"> </span><span class=\"pre\">'wp'</span></em><a class=\"headerlink\" href=\"#pyrogram.enums.ClientPlatform.WP\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Windows Phone</p>\n</dd></dl>\n\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.enums.ClientPlatform.BB\">\n<span class=\"sig-name descname\"><span class=\"pre\">BB</span></span><em class=\"property\"><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">=</span></span><span class=\"w\"> </span><span class=\"pre\">'bb'</span></em><a class=\"headerlink\" href=\"#pyrogram.enums.ClientPlatform.BB\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Blackberry</p>\n</dd></dl>\n\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.enums.ClientPlatform.DESKTOP\">\n<span class=\"sig-name descname\"><span class=\"pre\">DESKTOP</span></span><em class=\"property\"><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">=</span></span><span class=\"w\"> </span><span class=\"pre\">'desktop'</span></em><a class=\"headerlink\" href=\"#pyrogram.enums.ClientPlatform.DESKTOP\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Desktop</p>\n</dd></dl>\n\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.enums.ClientPlatform.WEB\">\n<span class=\"sig-name descname\"><span class=\"pre\">WEB</span></span><em class=\"property\"><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">=</span></span><span class=\"w\"> </span><span class=\"pre\">'web'</span></em><a class=\"headerlink\" href=\"#pyrogram.enums.ClientPlatform.WEB\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Web</p>\n</dd></dl>\n\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.enums.ClientPlatform.UBP\">\n<span class=\"sig-name descname\"><span class=\"pre\">UBP</span></span><em class=\"property\"><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">=</span></span><span class=\"w\"> </span><span class=\"pre\">'ubp'</span></em><a class=\"headerlink\" href=\"#pyrogram.enums.ClientPlatform.UBP\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Ubuntu Phone</p>\n</dd></dl>\n\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.enums.ClientPlatform.OTHER\">\n<span class=\"sig-name descname\"><span class=\"pre\">OTHER</span></span><em class=\"property\"><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">=</span></span><span class=\"w\"> </span><span class=\"pre\">'other'</span></em><a class=\"headerlink\" href=\"#pyrogram.enums.ClientPlatform.OTHER\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Other</p>\n</dd></dl>\n\n</dd></dl>\n\n<script>\n  document\n    .querySelectorAll(\"em.property\")\n    .forEach((elem, i) => i !== 0 ? elem.remove() : true)\n  document\n    .querySelectorAll(\"a.headerlink\")\n    .forEach((elem, i) => [0, 1].includes(i) ? true : elem.remove())\n</script></section>\n", "metatags": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n", "rellinks": [["genindex", "General Index", "I", "index"], ["py-modindex", "Python Module Index", "", "modules"], ["api/enums/MessageEntityType", "MessageEntityType", "N", "next"], ["api/enums/ChatJoinType", "ChatJoinType", "P", "previous"]], "sourcename": "", "toc": "<ul>\n<li><a class=\"reference internal\" href=\"#\">ClientPlatform</a><ul>\n<li><a class=\"reference internal\" href=\"#pyrogram.enums.ClientPlatform\"><code class=\"docutils literal notranslate\"><span class=\"pre\">ClientPlatform</span></code></a><ul>\n<li><a class=\"reference 