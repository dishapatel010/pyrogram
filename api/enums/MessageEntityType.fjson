{"parents": [{"link": "../", "title": "Enumerations"}], "prev": {"link": "../ClientPlatform/", "title": "ClientPlatform"}, "next": {"link": "../MessageMediaType/", "title": "MessageMediaType"}, "title": "MessageEntityType", "meta": null, "body": "<section id=\"messageentitytype\">\n<h1>MessageEntityType<a class=\"headerlink\" href=\"#messageentitytype\" title=\"Link to this heading\">\u00b6</a></h1>\n<dl class=\"py class\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.enums.MessageEntityType\">\n<em class=\"property\"><span class=\"pre\">class</span><span class=\"w\"> </span></em><span class=\"sig-prename descclassname\"><span class=\"pre\">pyrogram.enums.</span></span><span class=\"sig-name descname\"><span class=\"pre\">MessageEntityType</span></span><a class=\"headerlink\" href=\"#pyrogram.enums.MessageEntityType\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Message entity type enumeration used in <a class=\"reference internal\" href=\"../../types/MessageEntity/#pyrogram.types.MessageEntity\" title=\"pyrogram.types.MessageEntity\"><code class=\"xref py py-obj docutils literal notranslate\"><span class=\"pre\">MessageEntity</span></code></a>.</p>\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.enums.MessageEntityType.MENTION\">\n<span class=\"sig-name descname\"><span class=\"pre\">MENTION</span></span><em class=\"property\"><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">=</span></span><span class=\"w\"> </span><span class=\"pre\">&lt;class</span> <span class=\"pre\">'pyrogram.raw.types.message_entity_mention.MessageEntityMention'&gt;</span></em><a class=\"headerlink\" href=\"#pyrogram.enums.MessageEntityType.MENTION\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p><code class=\"docutils literal notranslate\"><span class=\"pre\">&#64;username</span></code></p>\n</dd></dl>\n\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.enums.MessageEntityType.HASHTAG\">\n<span class=\"sig-name descname\"><span class=\"pre\">HASHTAG</span></span><em class=\"property\"><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">=</span></span><span class=\"w\"> </span><span class=\"pre\">&lt;class</span> <span class=\"pre\">'pyrogram.raw.types.message_entity_hashtag.MessageEntityHashtag'&gt;</span></em><a class=\"headerlink\" href=\"#pyrogram.enums.MessageEntityType.HASHTAG\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p><code class=\"docutils literal notranslate\"><span class=\"pre\">#hashtag</span> <span class=\"pre\">or</span> <span class=\"pre\">#hashtag&#64;PyrogramChat</span></code></p>\n</dd></dl>\n\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.enums.MessageEntityType.CASHTAG\">\n<span class=\"sig-name descname\"><span class=\"pre\">CASHTAG</span></span><em class=\"property\"><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">=</span></span><span class=\"w\"> </span><span class=\"pre\">&lt;class</span> <span class=\"pre\">'pyrogram.raw.types.message_entity_cashtag.MessageEntityCashtag'&gt;</span></em><a class=\"headerlink\" href=\"#pyrogram.enums.MessageEntityType.CASHTAG\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p><code class=\"docutils literal notranslate\"><span class=\"pre\">$USD</span> <span class=\"pre\">or</span> <span class=\"pre\">$USD&#64;PyrogramChat</span></code></p>\n</dd></dl>\n\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.enums.MessageEntityType.BOT_COMMAND\">\n<span class=\"sig-name descname\"><span class=\"pre\">BOT_COMMAND</span></span><em class=\"property\"><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">=</span></span><span class=\"w\"> </span><span class=\"pre\">&lt;class</span> <span class=\"pre\">'pyrogram.raw.types.message_entity_bot_command.MessageEntityBotCommand'&gt;</span></em><a class=\"headerlink\" href=\"#pyrogram.enums.MessageEntityType.BOT_COMMAND\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p><code class=\"docutils literal notranslate\"><span class=\"pre\">/start&#64;pyrogrambot</span></code></p>\n</dd></dl>\n\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.enums.MessageEntityType.URL\">\n<span class=\"sig-name descname\"><span class=\"pre\">URL</span></span><em class=\"property\"><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">=</span></span><span class=\"w\"> </span><span class=\"pre\">&lt;class</span> <span class=\"pre\">'pyrogram.raw.types.message_entity_url.MessageEntityUrl'&gt;</span></em><a class=\"headerlink\" href=\"#pyrogram.enums.MessageEntityType.URL\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p><code class=\"docutils literal notranslate\"><span class=\"pre\">https://pyrogram.org</span></code> (see <code class=\"docutils literal notranslate\"><span class=\"pre\">url</span></code>)</p>\n</dd></dl>\n\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.enums.MessageEntityType.EMAIL\">\n<span class=\"sig-name descname\"><span class=\"pre\">EMAIL</span></span><em class=\"property\"><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">=</span></span><span class=\"w\"> </span><span class=\"pre\">&lt;class</span> <span class=\"pre\">'pyrogram.raw.types.message_entity_email.MessageEntityEmail'&gt;</span></em><a class=\"headerlink\" href=\"#pyrogram.enums.MessageEntityType.EMAIL\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p><code class=\"docutils literal notranslate\"><span class=\"pre\">do-not-reply&#64;pyrogram.org</span></code></p>\n</dd></dl>\n\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.enums.MessageEntityType.PHONE_NUMBER\">\n<span class=\"sig-name descname\"><span class=\"pre\">PHONE_NUMBER</span></span><em class=\"property\"><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">=</span></span><span class=\"w\"> </span><span class=\"pre\">&lt;class</span> <span class=\"pre\">'pyrogram.raw.types.message_entity_phone.MessageEntityPhone'&gt;</span></em><a class=\"headerlink\" href=\"#pyrogram.enums.MessageEntityType.PHONE_NUMBER\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p><code class=\"docutils literal notranslate\"><span class=\"pre\">+1-123-456-7890</span></code></p>\n</dd></dl>\n\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.enums.MessageEntityType.BOLD\">\n<span class=\"sig-name descname\"><span class=\"pre\">BOLD</span></span><em class=\"property\"><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">=</span></span><span class=\"w\"> </span><span class=\"pre\">&lt;class</span> <span class=\"pre\">'pyrogram.raw.types.message_entity_bold.MessageEntityBold'&gt;</span></em><a class=\"headerlink\" href=\"#pyrogram.enums.MessageEntityType.BOLD\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Bold text</p>\n</dd></dl>\n\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.enums.MessageEntityType.ITALIC\">\n<span class=\"sig-name descname\"><span class=\"pre\">ITALIC</span></span><em class=\"property\"><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">=</span></span><span class=\"w\"> </span><span class=\"pre\">&lt;class</span> <span class=\"pre\">'pyrogram.raw.types.message_entity_italic.MessageEntityItalic'&gt;</span></em><a class=\"headerlink\" href=\"#pyrogram.enums.MessageEntityType.ITALIC\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Italic text</p>\n</dd></dl>\n\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.enums.MessageEntityType.UNDERLINE\">\n<span class=\"sig-name descname\"><span class=\"pre\">UNDERLINE</span></span><em class=\"property\"><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">=</span></span><span class=\"w\"> </span><span class=\"pre\">&lt;class</span> <span class=\"pre\">'pyrogram.raw.types.message_entity_underline.MessageEntityUnderline'&gt;</span></em><a class=\"headerlink\" href=\"#pyrogram.enums.MessageEntityType.UNDERLINE\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Underlined text</p>\n</dd></dl>\n\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.enums.MessageEntityType.STRIKETHROUGH\">\n<span class=\"sig-name descname\"><span class=\"pre\">STRIKETHROUGH</span></span><em class=\"property\"><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">=</span></span><span class=\"w\"> </span><span class=\"pre\">&lt;class</span> <span class=\"pre\">'pyrogram.raw.types.message_entity_strike.MessageEntityStrike'&gt;</span></em><a class=\"headerlink\" href=\"#pyrogram.enums.MessageEntityType.STRIKETHROUGH\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Strikethrough text</p>\n</dd></dl>\n\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.enums.MessageEntityType.SPOILER\">\n<span class=\"sig-name descname\"><span class=\"pre\">SPOILER</span></span><em class=\"property\"><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">=</span></span><span class=\"w\"> </span><span class=\"pre\">&lt;class</span> <span class=\"pre\">'pyrogram.raw.types.message_entity_spoiler.MessageEntitySpoiler'&gt;</span></em><a class=\"headerlink\" href=\"#pyrogram.enums.MessageEntityType.SPOILER\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Spoiler text</p>\n</dd></dl>\n\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.enums.MessageEntityType.BLOCKQUOTE\">\n<span class=\"sig-name descname\"><span class=\"pre\">BLOCKQUOTE</span></span><em class=\"property\"><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">=</span></span><span class=\"w\"> </span><span class=\"pre\">'blockquote'</span></em><a class=\"headerlink\" href=\"#pyrogram.enums.MessageEntityType.BLOCKQUOTE\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Block quotation</p>\n</dd></dl>\n\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.enums.MessageEntityType.EXPANDABLE_BLOCKQUOTE\">\n<span class=\"sig-name descname\"><span class=\"pre\">EXPANDABLE_BLOCKQUOTE</span></span><em class=\"property\"><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">=</span></span><span class=\"w\"> </span><span class=\"pre\">'expandable_blockquote'</span></em><a class=\"headerlink\" href=\"#pyrogram.enums.MessageEntityType.EXPANDABLE_BLOCKQUOTE\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>collapsed-by-default block quotation</p>\n</dd></dl>\n\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.enums.MessageEntityType.CODE\">\n<span class=\"sig-name descname\"><span class=\"pre\">CODE</span></span><em class=\"property\"><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">=</span></span><span class=\"w\"> </span><span class=\"pre\">&lt;class</span> <span class=\"pre\">'pyrogram.raw.types.message_entity_code.MessageEntityCode'&gt;</span></em><a class=\"headerlink\" href=\"#pyrogram.enums.MessageEntityType.CODE\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Monowidth string</p>\n</dd></dl>\n\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.enums.MessageEntityType.PRE\">\n<span class=\"sig-name descname\"><span class=\"pre\">PRE</span></span><em class=\"property\"><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">=</span></span><span class=\"w\"> </span><span class=\"pre\">&lt;class</span> <span class=\"pre\">'pyrogram.raw.types.message_entity_pre.MessageEntityPre'&gt;</span></em><a class=\"headerlink\" href=\"#pyrogram.enums.MessageEntityType.PRE\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Monowidth block (see <code class=\"docutils literal notranslate\"><span class=\"pre\">language</span></code>)</p>\n</dd></dl>\n\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.enums.MessageEntityType.TEXT_LINK\">\n<span class=\"sig-name descname\"><span class=\"pre\">TEXT_LINK</span></span><em class=\"property\"><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">=</span></span><span class=\"w\"> </span><span class=\"pre\">&lt;class</span> <span class=\"pre\">'pyrogram.raw.types.message_entity_text_url.MessageEntityTextUrl'&gt;</span></em><a class=\"headerlink\" href=\"#pyrogram.enums.MessageEntityType.TEXT_LINK\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>For clickable text URLs</p>\n</dd></dl>\n\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.enums.MessageEntityType.TEXT_MENTION\">\n<span class=\"sig-name descname\"><span class=\"pre\">TEXT_MENTION</span></span><em class=\"property\"><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">=</span></span><span class=\"w\"> </span><span class=\"pre\">&lt;class</span> <span class=\"pre\">'pyrogram.raw.types.message_entity_mention_name.MessageEntityMentionName'&gt;</span></em><a class=\"headerlink\" href=\"#pyrogram.enums.MessageEntityType.TEXT_MENTION\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>for users without usernames (see <code class=\"docutils literal notranslate\"><span class=\"pre\">user</span></code>)</p>\n</dd></dl>\n\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.enums.MessageEntityType.CUSTOM_EMOJI\">\n<span class=\"sig-name descname\"><span class=\"pre\">CUSTOM_EMOJI</span></span><em class=\"property\"><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">=</span></span><span class=\"w\"> </span><span class=\"pre\">&lt;class</span> <span class=\"pre\">'pyrogram.raw.types.message_entity_custom_emoji.MessageEntityCustomEmoji'&gt;</span></em><a class=\"headerlink\" href=\"#pyrogram.enums.MessageEntityType.CUSTOM_EMOJI\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Custom emoji</p>\n</dd></dl>\n\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.enums.MessageEntityType.BANK_CARD\">\n<span class=\"sig-name descname\"><span class=\"pre\">BANK_CARD</span></span><em class=\"property\"><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">=</span></span><span class=\"w\"> </span><span class=\"pre\">&lt;class</span> <span class=\"pre\">'pyrogram.raw.types.message_entity_bank_card.MessageEntityBankCard'&gt;</span></em><a class=\"headerlink\" href=\"#pyrogram.enums.MessageEntityType.BANK_CARD\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Bank card text</p>\n</dd></dl>\n\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.enums.MessageEntityType.UNKNOWN\">\n<span class=\"sig-name descname\"><span class=\"pre\">UNKNOWN</span></span><em class=\"property\"><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">=</span></span><span class=\"w\"> </span><span class=\"pre\">&lt;class</span> <span class=\"pre\">'pyrogram.raw.types.message_entity_unknown.MessageEntityUnknown'&gt;</span></em><a class=\"headerlink\" href=\"#pyrogram.enums.MessageEntityType.UNKNOWN\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Unknown message entity type</p>\n</dd></dl>\n\n</dd></dl>\n\n<script>\n  document\n    .querySelectorAll(\"em.property\")\n    .forEach((elem, i) => i !== 0 ? elem.remove() : true)\n  document\n    .querySelectorAll(\"a.headerlink\")\n    .forEach((elem, i) => [0, 1].includes(i) ? true : elem.remove())\n</script></section>\n", "metatags": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n", "rellinks": [["genindex", "General Index", "I", "index"], ["py-modindex", "Python Module Index", "", "modules"], ["api/enums/MessageMediaType", "MessageMediaType", "N", "next"], ["api/enums/ClientPlatform", "ClientPlatform", "P", "previous"]], "sourcename": "", "toc": "<ul>\n<li><a class=\"reference internal\" href=\"#\">MessageEntityType</a><ul>\n<li><a class=\"reference internal\" href=\"#pyrogram.enums.MessageEntityType\"><code class=\"docutils literal notranslate\"><span class=\"pre\">Mess