{"parents": [{"link": "../", "title": "Enumerations"}], "prev": {"link": "../MessageEntityType/", "title": "MessageEntityType"}, "next": {"link": "../MessageOriginType/", "title": "MessageOriginType"}, "title": "MessageMediaType", "meta": null, "body": "<section id=\"messagemediatype\">\n<h1>MessageMediaType<a class=\"headerlink\" href=\"#messagemediatype\" title=\"Link to this heading\">\u00b6</a></h1>\n<dl class=\"py class\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.enums.MessageMediaType\">\n<em class=\"property\"><span class=\"pre\">class</span><span class=\"w\"> </span></em><span class=\"sig-prename descclassname\"><span class=\"pre\">pyrogram.enums.</span></span><span class=\"sig-name descname\"><span class=\"pre\">MessageMediaType</span></span><a class=\"headerlink\" href=\"#pyrogram.enums.MessageMediaType\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Message media type enumeration used in <a class=\"reference internal\" href=\"../../types/Message/#pyrogram.types.Message\" title=\"pyrogram.types.Message\"><code class=\"xref py py-obj docutils literal notranslate\"><span class=\"pre\">Message</span></code></a>.</p>\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.enums.MessageMediaType.AUDIO\">\n<span class=\"sig-name descname\"><span class=\"pre\">AUDIO</span></span><em class=\"property\"><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">=</span></span><span class=\"w\"> </span><span class=\"pre\">'audio'</span></em><a class=\"headerlink\" href=\"#pyrogram.enums.MessageMediaType.AUDIO\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Audio media</p>\n</dd></dl>\n\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.enums.MessageMediaType.DOCUMENT\">\n<span class=\"sig-name descname\"><span class=\"pre\">DOCUMENT</span></span><em class=\"property\"><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">=</span></span><span class=\"w\"> </span><span class=\"pre\">'document'</span></em><a class=\"headerlink\" href=\"#pyrogram.enums.MessageMediaType.DOCUMENT\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Document media</p>\n</dd></dl>\n\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.enums.MessageMediaType.PHOTO\">\n<span class=\"sig-name descname\"><span class=\"pre\">PHOTO</span></span><em class=\"property\"><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">=</span></span><span class=\"w\"> </span><span class=\"pre\">'photo'</span></em><a class=\"headerlink\" href=\"#pyrogram.enums.MessageMediaType.PHOTO\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Photo media</p>\n</dd></dl>\n\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.enums.MessageMediaType.STICKER\">\n<span class=\"sig-name descname\"><span class=\"pre\">STICKER</span></span><em class=\"property\"><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">=</span></span><span class=\"w\"> </span><span class=\"pre\">'sticker'</span></em><a class=\"headerlink\" href=\"#pyrogram.enums.MessageMediaType.STICKER\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Sticker media</p>\n</dd></dl>\n\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.enums.MessageMediaType.VIDEO\">\n<span class=\"sig-name descname\"><span class=\"pre\">VIDEO</span></span><em class=\"property\"><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">=</span></span><span class=\"w\"> </span><span class=\"pre\">'video'</span></em><a class=\"headerlink\" href=\"#pyrogram.enums.MessageMediaType.VIDEO\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Video media</p>\n</dd></dl>\n\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.enums.MessageMediaType.ANIMATION\">\n<span class=\"sig-name descname\"><span class=\"pre\">ANIMATION</span></span><em class=\"property\"><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">=</span></span><span class=\"w\"> </span><span class=\"pre\">'animation'</span></em><a class=\"headerlink\" href=\"#pyrogram.enums.MessageMediaType.ANIMATION\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Animation media</p>\n</dd></dl>\n\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.enums.MessageMediaType.VOICE\">\n<span class=\"sig-name descname\"><span class=\"pre\">VOICE</span></span><em class=\"property\"><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">=</span></span><span class=\"w\"> </span><span class=\"pre\">'voice'</span></em><a class=\"headerlink\" href=\"#pyrogram.enums.MessageMediaType.VOICE\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Voice media</p>\n</dd></dl>\n\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.enums.MessageMediaType.VIDEO_NOTE\">\n<span class=\"sig-name descname\"><span class=\"pre\">VIDEO_NOTE</span></span><em class=\"property\"><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">=</span></span><span class=\"w\"> </span><span class=\"pre\">'video_note'</span></em><a class=\"headerlink\" href=\"#pyrogram.enums.MessageMediaType.VIDEO_NOTE\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Video note media</p>\n</dd></dl>\n\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.enums.MessageMediaType.CONTACT\">\n<span class=\"sig-name descname\"><span class=\"pre\">CONTACT</span></span><em class=\"property\"><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">=</span></span><span class=\"w\"> </span><span class=\"pre\">'contact'</span></em><a class=\"headerlink\" href=\"#pyrogram.enums.MessageMediaType.CONTACT\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Contact media</p>\n</dd></dl>\n\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.enums.MessageMediaType.LOCATION\">\n<span class=\"sig-name descname\"><span class=\"pre\">LOCATION</span