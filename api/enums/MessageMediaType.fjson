=\"sig-name descname\"><span class=\"pre\">DICE</span></span><em class=\"property\"><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">=</span></span><span class=\"w\"> </span><span class=\"pre\">'dice'</span></em><a class=\"headerlink\" href=\"#pyrogram.enums.MessageMediaType.DICE\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Dice media</p>\n</dd></dl>\n\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.enums.MessageMediaType.GAME\">\n<span class=\"sig-name descname\"><span class=\"pre\">GAME</span></span><em class=\"property\"><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">=</span></span><span class=\"w\"> </span><span class=\"pre\">'game'</span></em><a class=\"headerlink\" href=\"#pyrogram.enums.MessageMediaType.GAME\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Game media</p>\n</dd></dl>\n\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.enums.MessageMediaType.STORY\">\n<span class=\"sig-name descname\"><span class=\"pre\">STORY</span></span><em class=\"property\"><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">=</span></span><span class=\"w\"> </span><span class=\"pre\">'story'</span></em><a class=\"headerlink\" href=\"#pyrogram.enums.MessageMediaType.STORY\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Story</p>\n</dd></dl>\n\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.enums.MessageMediaType.GIVEAWAY\">\n<span class=\"sig-name descname\"><span class=\"pre\">GIVEAWAY</span></span><em class=\"property\"><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">=</span></span><span class=\"w\"> </span><span class=\"pre\">'giveaway'</span></em><a class=\"headerlink\" href=\"#pyrogram.enums.MessageMediaType.GIVEAWAY\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Giveaway</p>\n</dd></dl>\n\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.enums.MessageMediaType.GIVEAWAY_WINNERS\">\n<span class=\"sig-name descname\"><span class=\"pre\">GIVEAWAY_WINNERS</span></span><em class=\"property\"><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">=</span></span><span class=\"w\"> </span><span class=\"pre\">'giveaway_winners'</span></em><a class=\"headerlink\" href=\"#pyrogram.enums.MessageMediaType.GIVEAWAY_WINNERS\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Giveaway Winners</p>\n</dd></dl>\n\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.enums.MessageMediaType.INVOICE\">\n<span class=\"sig-name descname\"><span class=\"pre\">INVOICE</span></span><em class=\"property\"><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">=</span></span><span class=\"w\"> </span><span class=\"pre\">'invoice'</span></em><a class=\"headerlink\" href=\"#pyrogram.enums.MessageMediaType.INVOICE\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Invoice</p>\n</dd></dl>\n\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.enums.MessageMediaType.PAID_MEDIA\">\n<span class=\"sig-name descname\"><span class=\"pre\">PAID_MEDIA</span></span><em class=\"property\"><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">=</span></span><span class=\"w\"> </span><span class=\"pre\">'paid_media'</span></em><a class=\"headerlink\" href=\"#pyrogram.enums.MessageMediaType.PAID_MEDIA\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Paid Media</p>\n</dd></dl>\n\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.enums.MessageMediaType.CHECKLIST\">\n<span class=\"sig-name descname\"><span class=\"pre\">CHECKLIST</span></span><em class=\"property\"><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">=</span></span><span class=\"w\"> </span><span class=\"pre\">'checklist'</span></em><a class=\"headerlink\" href=\"#pyrogram.enums.MessageMediaType.CHECKLIST\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Checklist</p>\n</dd></dl>\n\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.enums.MessageMediaType.UNKNOWN\">\n<span class=\"sig-name descname\"><span class=\"pre\">UNKNOWN</span></span><em class=\"property\"><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">=</span></span><span class=\"w\"> </span><span class=\"pre\">'unknown'</span></em><a class=\"headerlink\" href=\"#pyrogram.enums.MessageMediaType.UNKNOWN\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>This message media is unsupported by the current version of Pyrogram</p>\n</dd></dl>\n\n</dd></dl>\n\n<script>\n  document\n    .querySelectorAll(\"em.property\")\n    .forEach((elem, i) => i !== 0 ? elem.remove() : true)\n  document\n    .querySelectorAll(\"a.headerlink\")\n    .forEach((elem, i) => [0, 1].includes(i) ? true : elem.remove())\n</script></section>\n", "metatags": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n", "rellinks": [["genindex", "General Index", "I", "index"], ["py-modindex", "Python Module Index", "", "modules"], ["api/enums/MessageOriginType", "MessageOriginType", "N", "next"], ["api/enums/MessageEntityType", "MessageEntityType", "P", "previous"]], "sourcename": "", "toc": "<ul>\n<li><a class=\"reference internal\" href=\"#\">MessageMediaType</a><ul>\n<li><a class=\"reference internal\" href=\"#pyrogram.enums.MessageMediaType\"><code class=\"docutils literal notranslate\"><span class=\"pre\">MessageMediaType</span></code></a><ul>\n<li><a class=\"reference internal\" href=\"#pyrogram.enums.MessageMediaType.AUDIO\"><code class=\"docutils literal notranslate\"><span class=\"pre\">MessageMediaType.AUDIO</span></code></a></li>\n<li><a class=\"reference internal\" href=\"#pyrogram.enums.MessageMediaType.DOCUMENT\"><code class=\"docutils literal notranslate\"><span class=\"pre\">MessageMediaType.DOCUMENT</span></code></a></li>\n<li><a class=\"reference internal\" href=\"#pyrogram.enums.MessageMediaType.PHOTO