py\" id=\"pyrogram.enums.ParseMode.HTML\">\n<span class=\"sig-name descname\"><span class=\"pre\">HTML</span></span><em class=\"property\"><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">=</span></span><span class=\"w\"> </span><span class=\"pre\">'html'</span></em><a class=\"headerlink\" href=\"#pyrogram.enums.ParseMode.HTML\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>HTML only mode</p>\n</dd></dl>\n\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.enums.ParseMode.DISABLED\">\n<span class=\"sig-name descname\"><span class=\"pre\">DISABLED</span></span><em class=\"property\"><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">=</span></span><span class=\"w\"> </span><span class=\"pre\">'disabled'</span></em><a class=\"headerlink\" href=\"#pyrogram.enums.ParseMode.DISABLED\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Disabled mode</p>\n</dd></dl>\n\n</dd></dl>\n\n<script>\n  document\n    .querySelectorAll(\"em.property\")\n    .forEach((elem, i) => i !== 0 ? elem.remove() : true)\n  document\n    .querySelectorAll(\"a.headerlink\")\n    .forEach((elem, i) => [0, 1].includes(i) ? true : elem.remove())\n</script></section>\n", "metatags": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n", "rellinks": [["genindex", "General Index", "I", "index"], ["py-modindex", "Python Module Index", "", "modules"], ["api/enums/PollType", "PollType", "N", "next"], ["api/enums/MessagesFilter", "MessagesFilter", "P", "previous"]], "sourcename": "", "toc": "<ul>\n<li><a class=\"reference internal\" href=\"#\">ParseMode</a><ul>\n<li><a class=\"reference internal\" href=\"#pyrogram.enums.ParseMode\"><code class=\"docutils literal notranslate\"><span class=\"pre\">ParseMode</span></code></a><ul>\n<li><a class=\"reference internal\" href=\"#pyrogram.enums.ParseMode.DEFAULT\"><code class=\"docutils literal notranslate\"><span class=\"pre\">ParseMode.DEFAULT</span></code></a></li>