{"parents": [{"link": "../", "title": "Enumerations"}], "prev": {"link": "../ParseMode/", "title": "ParseMode"}, "next": {"link": "../ProfileColor/", "title": "ProfileColor"}, "title": "PollType", "meta": null, "body": "<section id=\"polltype\">\n<h1>PollType<a class=\"headerlink\" href=\"#polltype\" title=\"Link to this heading\">\u00b6</a></h1>\n<dl class=\"py class\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.enums.PollType\">\n<em class=\"property\"><span class=\"pre\">class</span><span class=\"w\"> </span></em><span class=\"sig-prename descclassname\"><span class=\"pre\">pyrogram.enums.</span></span><span class=\"sig-name descname\"><span class=\"pre\">PollType</span></span><a class=\"headerlink\" href=\"#pyrogram.enums.PollType\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Poll type enumeration used in <a class=\"reference internal\" href=\"../../types/Poll/#pyrogram.types.Poll\" title=\"pyrogram.types.Poll\"><code class=\"xref py py-obj docutils literal notranslate\"><span class=\"pre\">Poll</span></code></a>.</p>\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.enums.PollType.QUIZ\">\n<span class=\"sig-name descname\"><span class=\"pre\">QUIZ</span></span><em class=\"property\"><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">=</span></span><span class=\"w\"> </span><span class=\"pre\">'quiz'</span></em><a class=\"headerlink\" href=\"#pyrogram.enums.PollType.QUIZ\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Quiz poll</p>\n</dd></dl>\n\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.enums.PollType.REGULAR\">\n<span class=\"sig-name descname\"><span class=\"pre\">REGULAR</span></span><em class=\"property\"><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">=</span></span><span class=\"w\"> </span><span class=\"pre\">'regular'</span></em><a class=\"headerlink\" href=\"#pyrogram.enums.PollType.REGULAR\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Regular poll</p>\n</dd></dl>\n\n</dd></dl>\n\n<script>\n  document\n    .querySelectorAll(\"em.property\")\n    .forEach((elem, i) => i !== 0 ? elem.remove() : true)\n  document\n    .querySelectorAll(\"a.headerlink\")\n    .forEach((elem, i) => [0, 1].includes(i) ? true : elem.remove())\n</script></section>\n", "metatags": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n", "rellinks": [["genindex", "General Index", "I", "index"], ["py-modindex", "Python Module Index", "", "modules"], ["api/enums/ProfileColor", "ProfileColor", "N", "next"], ["api/enums/ParseMode", "ParseMode", "P", "previous"]], "sourcename": "", "toc": "<ul>\n<li><a class=\"reference internal\" href=\"#\">PollType</a><ul>\n<li><a class=\"reference internal\" href=\"#pyrogram.enums.PollType\"><code class=\"docutils literal notranslate\"><span class=\"pre\">PollType</span></code></a><ul>\n<li><a class=\"reference internal\" href=\"#pyrogram.enums.PollType.QUIZ\"><code class=\"docutils literal notranslate\"><span class=\"pre\">PollType.QUIZ</span></code></a></li>\n<li><a class=\"reference internal\" href=\"#pyrogram.enums.PollType.REGULAR\"><code class=\"docutils literal notranslate\"><span class=\"pre\">PollType.REGULAR</span></code></a></li>\n</ul>\n</li>\n</ul>\n</li>\n</ul>\n", "display_toc": true, "page_source_suffix": ".rst", "current_page_name": "api/enums/PollType", "sidebars": ["sidebar/brand.html", "sidebar/search.html", "sidebar/scroll-start.html", "sidebar/navigation.html", "sidebar/scroll-end.html"], "alabaster_version": "1.0.0", "alabaster_version_info": [1, 0, 0], "furo_version": "2025.12.19", "furo_navigation_tree": "", "furo_hide_toc": false, "furo_pygments": {"light": {"background": "#eeffcc", "foreground": "black"}, "dark": {"background": "#202020", "foreground": "#d0d0d0"}}}