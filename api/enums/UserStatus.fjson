{"parents": [{"link": "../", "title": "Enumerations"}], "prev": {"link": "../NextCodeType/", "title": "NextCodeType"}, "next": {"link": "../../handlers/", "title": "Update Handlers"}, "title": "UserStatus", "meta": null, "body": "<section id=\"userstatus\">\n<h1>UserStatus<a class=\"headerlink\" href=\"#userstatus\" title=\"Link to this heading\">\u00b6</a></h1>\n<dl class=\"py class\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.enums.UserStatus\">\n<em class=\"property\"><span class=\"pre\">class</span><span class=\"w\"> </span></em><span class=\"sig-prename descclassname\"><span class=\"pre\">pyrogram.enums.</span></span><span class=\"sig-name descname\"><span class=\"pre\">UserStatus</span></span><a class=\"headerlink\" href=\"#pyrogram.enums.UserStatus\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>User status enumeration used in <a class=\"reference internal\" href=\"../../types/User/#pyrogram.types.User\" title=\"pyrogram.types.User\"><code class=\"xref py py-obj docutils literal notranslate\"><span class=\"pre\">User</span></code></a>.</p>\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.enums.UserStatus.ONLINE\">\n<span class=\"sig-name descname\"><span class=\"pre\">ONLINE</span></span><em class=\"property\"><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">=</span></span><span class=\"w\"> </span><span class=\"pre\">'online'</span></em><a class=\"headerlink\" href=\"#pyrogram.enums.UserStatus.ONLINE\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>User is online</p>\n</dd></dl>\n\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.enums.UserStatus.OFFLINE\">\n<span class=\"sig-name descname\"><span class=\"pre\">OFFLINE</span></span><em class=\"property\"><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">=</span></span><span class=\"w\"> </span><span class=\"pre\">'offline'</span></em><a class=\"headerlink\" href=\"#pyrogram.enums.UserStatus.OFFLINE\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>User is offline</p>\n</dd></dl>\n\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.enums.UserStatus.RECENTLY\">\n<span class=\"sig-name descname\"><span class=\"pre\">RECENTLY</span></span><em class=\"property\"><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">=</span></span><span class=\"w\"> </span><span class=\"pre\">'recently'</span></em><a class=\"headerlink\" href=\"#pyrogram.enums.UserStatus.RECENTLY\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>User was seen recently</p>\n</dd></dl>\n\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.enums.UserStatus.LAST_WEEK\">\n<span class=\"sig-name descname\"><span class=\"pre\">LAST_WEEK</span></span><em class=\"property\"><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">=</span></span><span class=\"w\"> </span><span class=\"pre\">'last_week'</span></em><a class=\"headerlink\" href=\"#pyrogram.enums.UserStatus.LAST_WEEK\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>User was seen last week</p>\n</dd></dl>\n\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.enums.UserStatus.LAST_MONTH\">\n<span class=\"sig-name descname\"><span class=\"pre\">LAST_MONTH</span></span><em class=\"property\"><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">=</span></span><span class=\"w\"> </span><span class=\"pre\">'last_month'</span></em><a class=\"headerlink\" href=\"#pyrogram.enums.UserStatus.LAST_MONTH\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>User was seen last month</p>\n</dd></dl>\n\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.enums.UserStatus.LONG_AGO\">\n<span class=\"sig-name descname\"><span class=\"pre\">LONG_AGO</span></span><em class=\"property\"><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">=</span></span><span class=\"w\"> </span><span class=\"pre\">'long_ago'</span></em><a class=\"headerlink\" href=\"#pyrogram.enums.UserStatus.LONG_AGO\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>User was seen long ago</p>\n</dd></dl>\n\n</dd></dl>\n\n<script>\n  document\n    .querySelectorAll(\"em.property\")\n    .forEach((elem, i) => i !== 0 ? elem.remove() : true)\n  document\n    .querySelectorAll(\"a.headerlink\")\n    .forEach((elem, i) => [0, 1].includes(i) ? true : elem.remove())\n</script></section>\n", "metatags": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n", "rellinks": [["genindex", "General Index", "I", "index"], ["py-modindex", "Python Module Index", "", "modules"], ["api/handlers", "Update Handlers", "N", "next"], ["api/enums/NextCodeType", "NextCodeType", "P", "previous"]], "sourcename": "", "toc": "<ul>\n<li><a class=\"reference internal\" href=\"#\">UserStatus</a><ul>\n<li><a class=\"reference internal\" href=\"#pyrogram.enums.UserStatus\"><code class=\"docutils literal notranslate\"><span class=\"pre\">UserStatus</span></code></a><ul>\n<li><a class=\"reference internal\" href=\"#pyrogram.enums.UserStatus.ONLINE\"><code class=\"docutils literal notranslate\"><span class=\"pre\">UserStatus.ONLINE</span></code></a></li>\n<li><a class=\"reference internal\" href=\"#pyrogram.enums.UserStatus.OFFLINE\"><code class=\"docutils literal notranslate\"><span class=\"pre\">UserStatus.OFFLINE</span></code></a></li>\n<li><a class=\"reference internal\" href=\"#pyrogram.enums.UserStatus.RECENTLY\"><code class=\"docutils literal notranslate\"><span class=\"pre\">UserStatus.RECENTLY</span></code></a></li>\n<li><a class=\"reference internal\" href=\"#pyrogram.enums.UserStatus.LAST_WEEK\"><code class=\"docutils literal notranslate\"><span class=\"pre\">UserStatus.LAST_WEEK</span></code></a></li>\n<li><a class=\"reference internal\" href=\"#pyrogram.enums.UserStatus.LAST_MONTH\"><code class=\"docutils literal notranslate\"><span class=\"pre\">UserStatus.LAST_MONTH</span></code></a></li>\n<li><a class=\"reference internal\" href=\"#pyrogram.enums.UserStatus.LONG_AGO\"><code class=\"docutils literal notranslate\"><span class=\"pre\">UserStatus.LONG_AGO</span></code></a></li>\n</ul>\n</li>\n</ul>\n</li>\n</ul>\n", "display_toc": true, "page_source_suffix": ".rst", "current_page_name": "api/enums/UserStatus", "sidebars": ["sidebar/brand.html", "sidebar/search.html", "sidebar/scroll-start.html", "sidebar/navigation.html", "sidebar/scroll-end.html"], "alabaster_version": "1.0.0", "alabaster_version_info": [1, 0, 0], "furo_version": "2025.12.19", "furo_navigation_tree": "", "furo_hide_toc": false, "furo_pygments": {"light": {"background": "#eeffcc", "foreground": "black"}, "dark": {"background": "#202020", "foreground": "#d0d0d0"}}}