{"parents": [{"link": "../", "title": "RPC Errors"}], "prev": {"link": "../", "title": "RPC Errors"}, "next": {"link": "../bad-request/", "title": "400 - BadRequest"}, "title": "303 - SeeOther", "meta": null, "body": "<section id=\"seeother\">\n<h1>303 - SeeOther<a class=\"headerlink\" href=\"#seeother\" title=\"Link to this heading\">\u00b6</a></h1>\n<div class=\"table-wrapper docutils container\">\n<table class=\"docutils align-default\">\n<thead>\n<tr class=\"row-odd\"><th class=\"head\"><p>id</p></th>\n<th class=\"head\"><p>message</p></th>\n</tr>\n</thead>\n<tbody>\n<tr class=\"row-even\"><td><p>FILE_MIGRATE_X</p></td>\n<td><p>The file to be accessed is currently stored in DC{value}</p></td>\n</tr>\n<tr class=\"row-odd\"><td><p>NETWORK_MIGRATE_X</p></td>\n<td><p>Your IP address is associated to DC {value}, please re-send the query to that DC.</p></td>\n</tr>\n<tr class=\"row-even\"><td><p>PHONE_MIGRATE_X</p></td>\n<td><p>Your phone number is associated to DC {value}, please re-send the query to that DC.</p></td>\n</tr>\n<tr class=\"row-odd\"><td><p>STATS_MIGRATE_X</p></td>\n<td><p>Channel statistics for the specified channel are stored on DC {value}, please re-send the query to that DC.</p></td>\n</tr>\n<tr class=\"row-even\"><td><p>USER_MIGRATE_X</p></td>\n<td><p>Your account is associated to DC {value}, please re-send the query to that DC.</p></td>\n</tr>\n</tbody>\n</table>\n</div>\n</section>\n", "metatags": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n", "rellinks": [["genindex", "General Index", "I", "index"], ["py-modindex", "Python Module Index", "", "modules"], ["api/errors/bad-request", "400 - BadRequest", "N", "next"], ["api/errors/index", "RPC Errors", "P", "previous"]], "sourcename": "", "toc": "<ul>\n<li><a class=\"reference internal\" href=\"#\">303 - SeeOther</a></li>\n</ul>\n", "display_toc": false, "page_source_suffix": ".rst", "current_page_name": "api/errors/see-other", "sidebars": ["sidebar/brand.html", "sidebar/search.html", "sidebar/scroll-start.html", "sidebar/navigation.html", "sidebar/scroll-end.html"], "alabaster_version": "1.0.0", "alabaster_version_info": [1, 0, 0], "furo_version": "2025.12.19", "furo_navigation_tree": "", "furo_hide_toc": true, "furo_pygments": {"light": {"background": "#eeffcc", "foreground": "black"}, "dark": {"background": "#202020", "foreground": "#d0d0d0"}}}