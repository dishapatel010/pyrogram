{"parents": [{"link": "../", "title": "Available Methods"}], "prev": {"link": "../sign_in_bot/", "title": "sign_in_bot()"}, "next": {"link": "../send_code/", "title": "send_code()"}, "title": "connect()", "meta": null, "body": "<section id=\"connect\">\n<h1>connect()<a class=\"headerlink\" href=\"#connect\" title=\"Link to this heading\">\u00b6</a></h1>\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.Client.connect\">\n<span class=\"sig-prename descclassname\"><span class=\"pre\">Client.</span></span><span class=\"sig-name descname\"><span class=\"pre\">connect</span></span><span class=\"sig-paren\">(</span><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#pyrogram.Client.connect\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Connect the client to Telegram servers.</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Returns<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p><code class=\"docutils literal notranslate\"><span class=\"pre\">bool</span></code> \u2013 On success, in case the passed-in session is authorized, True is returned. Otherwise, in case\nthe session needs to be authorized, False is returned.</p>\n</dd>\n<dt class=\"field-even\">Raises<span class=\"colon\">:</span></dt>\n<dd class=\"field-even\"><p><a class=\"reference external\" href=\"https://docs.python.org/3/library/exceptions.html#ConnectionError\" title=\"(in Python v3.14)\"><strong>ConnectionError</strong></a> \u2013 In case you try to connect an already connected client.</p>\n</dd>\n</dl>\n</dd></dl>\n\n</section>\n", "metatags": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n", "rellinks": [["genindex", "General Index", "I", "index"], ["py-modindex", "Python Module Index", "", "modules"], ["api/methods/send_code", "send_code()", "N", "next"], ["api/methods/sign_in_bot", "sign_in_bot()", "P", "previous"]], "sourcename": "", "toc": "<ul>\n<li><a class=\"reference internal\" href=\"#\">connect()</a><ul>\n<li><a class=\"reference internal\" href=\"#pyrogram.Client.connect\"><code class=\"docutils literal notranslate\"><span class=\"pre\">Client.connect()</span></code></a></li>\n</ul>\n</li>\n</ul>\n", "display_toc": true, "page_source_suffix": ".rst", "current_page_name": "api/methods/connect", "sidebars": ["sidebar/brand.html", "sidebar/search.html", "sidebar/scroll-start.html", "sidebar/navigation.html", "sidebar/scroll-end.html"], "alabaster_version": "1.0.0", "alabaster_version_info": [1, 0, 0], "furo_version": "2025.12.19", "furo_navigation_tree": "", "furo_hide_toc": false, "furo_pygments": {"light": {"background": "#eeffcc", "foreground": "black"}, "dark": {"background": "#202020", "foreground": "#d0d0d0"}}}