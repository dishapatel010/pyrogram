{"parents": [{"link": "../", "title": "Available Methods"}], "prev": {"link": "../get_chat_invite_link_joiners_count/", "title": "get_chat_invite_link_joiners_count()"}, "next": {"link": "../delete_chat_admin_invite_links/", "title": "delete_chat_admin_invite_links()"}, "title": "delete_chat_invite_link()", "meta": null, "body": "<section id=\"delete-chat-invite-link\">\n<h1>delete_chat_invite_link()<a class=\"headerlink\" href=\"#delete-chat-invite-link\" title=\"Link to this heading\">\u00b6</a></h1>\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.Client.delete_chat_invite_link\">\n<span class=\"sig-prename descclassname\"><span class=\"pre\">Client.</span></span><span class=\"sig-name descname\"><span class=\"pre\">delete_chat_invite_link</span></span><span class=\"sig-paren\">(</span><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#pyrogram.Client.delete_chat_invite_link\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Delete an already revoked invite link.</p>\n<strong>Usable by</strong>\n<span class=\"usable-by\"><i class=\"fa-solid fa-check\" style=\"color: var(--color-green)\"></i> Users</span>\n<span class=\"usable-by\"><i class=\"fa-solid fa-xmark\" style=\"color: var(--color-red)\"></i> Bots</span><dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><ul class=\"simple\">\n<li><p><strong>chat_id</strong> (<code class=\"docutils literal notranslate\"><span class=\"pre\">int</span></code> | <code class=\"docutils literal notranslate\"><span class=\"pre\">str</span></code>) \u2013 Unique identifier for the target chat or username of the target channel/supergroup\n(in the format &#64;username).</p></li>\n<li><p><strong>invite_link</strong> (<code class=\"docutils literal notranslate\"><span class=\"pre\">str</span></code>) \u2013 The revoked invite link to delete.</p></li>\n</ul>\n</dd>\n<dt class=\"field-even\">Returns<span class=\"colon\">:</span></dt>\n<dd class=\"field-even\"><p><code class=\"docutils literal notranslate\"><span class=\"pre\">bool</span></code> \u2013 On success <code class=\"docutils literal notranslate\"><span class=\"pre\">True</span></code> is returned.</p>\n</dd>\n</dl>\n</dd></dl>\n\n</section>\n", "metatags": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n", "rellinks": [["genindex", "General Index", "I", "index"], ["py-modindex", "Python Module Index", "", "modules"], ["api/methods/delete_chat_admin_invite_links", "delete_chat_admin_invite_links()", "N", "next"], ["api/methods/get_chat_invite_link_joiners_count", "get_chat_invite_link_joiners_count()", "P", "previous"]], "sourcename": "", "toc": "<ul>\n<li><a class=\"reference internal\" href=\"#\">delete_chat_invite_link()</a><ul>\n<li><a class=\"reference internal\" href=\"#pyrogram.Client.delete_chat_invite_link\"><code class=\"docutils literal notranslate\"><span class=\"pre\">Client.delete_chat_invite_link()</span></code></a></li>\n</ul>\n</li>\n</ul>\n", "display_toc": true, "page_source_suffix": ".rst", "current_page_name": "api/methods/delete_chat_invite_link", "sidebars": ["sidebar/brand.html", "sidebar/search.html", "sidebar/scroll-start.html", "sidebar/navigation.html", "sidebar/scroll-end.html"], "alabaster_version": "1.0.0", "alabaster_version_info": [1, 0, 0], "furo_version": "2025.12.19", "furo_navigation_tree": "", "furo_hide_toc": false, "furo_pygments": {"light": {"background": "#eeffcc", "foreground": "black"}, "dark": {"background": "#202020", "foreground": "#d0d0d0"}}}