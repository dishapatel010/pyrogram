{"parents": [{"link": "../", "title": "Available Methods"}], "prev": {"link": "../log_out/", "title": "log_out()"}, "next": {"link": "../terminate/", "title": "terminate()"}, "title": "disconnect()", "meta": null, "body": "<section id=\"disconnect\">\n<h1>disconnect()<a class=\"headerlink\" href=\"#disconnect\" title=\"Link to this heading\">\u00b6</a></h1>\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.Client.disconnect\">\n<span class=\"sig-prename descclassname\"><span class=\"pre\">Client.</span></span><span class=\"sig-name descname\"><span class=\"pre\">disconnect</span></span><span class=\"sig-paren\">(</span><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#pyrogram.Client.disconnect\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Disconnect the client from Telegram servers.</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Raises<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p><a class=\"reference external\" href=\"https://docs.python.org/3/library/exceptions.html#ConnectionError\" title=\"(in Python v3.14)\"><strong>ConnectionError</strong></a> \u2013 In case you try to disconnect an already disconnected client or in case you try to\n    disconnect a client that needs to be terminated first.</p>\n</dd>\n</dl>\n</dd></dl>\n\n</section>\n", "metatags": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n", "rellinks": [["genindex", "General Index", "I", "index"], ["py-modindex", "Python Module Index", "", "modules"], ["api/methods/terminate", "terminate()", "N", "next"], ["api/methods/log_out", "log_out()", "P", "previous"]], "sourcename": "", "toc": "<ul>\n<li><a class=\"reference internal\" href=\"#\">disconnect()</a><ul>\n<li><a class=\"reference internal\" href=\"#pyrogram.Client.disconnect\"><code class=\"docutils literal notranslate\"><span class=\"pre\">Client.disconnect()</span></code></a></li>\n</ul>\n</li>\n</ul>\n", "display_toc": true, "page