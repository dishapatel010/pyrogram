{"parents": [{"link": "../", "title": "Available Methods"}], "prev": {"link": "../restart/", "title": "restart()"}, "next": {"link": "../add_handler/", "title": "add_handler()"}, "title": "export_session_string()", "meta": null, "body": "<section id=\"export-session-string\">\n<h1>export_session_string()<a class=\"headerlink\" href=\"#export-session-string\" title=\"Link to this heading\">\u00b6</a></h1>\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.Client.export_session_string\">\n<span class=\"sig-prename descclassname\"><span class=\"pre\">Client.</span></span><span class=\"sig-name descname\"><span class=\"pre\">export_session_string</span></span><span class=\"sig-paren\">(</span><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#pyrogram.Client.export_session_string\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Export the current authorized session as a serialized string.</p>\n<p>Session strings are useful for storing in-memory authorized sessions in a portable, serialized string.\nMore detailed information about session strings can be found at the dedicated page of\n<a class=\"reference internal\" href=\"../../../topics/storage-engines/\"><span class=\"doc\">Storage Engines</span></a>.</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Returns<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p><code class=\"docutils literal notranslate\"><span class=\"pre\">str</span></code> \u2013 The session serialized into a printable, url-safe string.</p>\n</dd>\n</dl>\n<p class=\"rubric\">Example</p>\n<div class=\"highlight-python notranslate\"><div class=\"highlight\"><pre><span></span><span class=\"n\">s</span> <span class=\"o\">=</span> <span class=\"k\">await</span> <span class=\"n\">app</span><span class=\"o\">.</span><span class=\"n\">export_session_string</span><span class=\"p\">()</span>\n</pre></div>\n</div>\n</dd></dl>\n\n</section>\n", "metatags": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n", "rellinks": [["genindex", "General Index", "I", "index"], ["py-modindex", "Python Module Index", "", "modules"], ["api/methods/add_handler", "add_handler()", "N", "next"], ["api/methods/restart", "restart()", "P", "previous"]], "sourcename": "", "toc": "<ul>\n<li><a class=\"reference internal\" href=\"#\">export_session_string()</a><ul>\n<li><a class=\"reference internal\" href=\"#pyrogram.Client.export_session_string\"><code class=\"docutils literal notranslate\"><span class=\"pre\">Client.export_session_string()</span></code></a></li>\n</ul>\n</li>\n</ul>\n", "display_toc": true, "page_source_suffix": ".rst", "current_page_name": "api/methods/export_session_string", "sidebars": ["sidebar/brand.html", "sidebar/search.html", "sidebar/scroll-start.html", "sidebar/navigation.html", "sidebar/scroll-end.html"], "alabaster_version": "1.0.0", "alabaster_version_info": [1, 0, 0], "furo_version": "2025.12.19", "furo_navigation_tree": "", "furo_hide_toc": false, "furo_pygments": {"light": {"background": "#eeffcc", "foreground": "black"}, "dark": {"background": "#202020", "foreground": "#d0d0d0"}}}