{"parents": [{"link": "../", "title": "Available Methods"}], "prev": {"link": "../get_chat_admin_invite_links_count/", "title": "get_chat_admin_invite_links_count()"}, "next": {"link": "../get_chat_invite_link/", "title": "get_chat_invite_link()"}, "title": "get_chat_admins_with_invite_links()", "meta": null, "body": "<section id=\"get-chat-admins-with-invite-links\">\n<h1>get_chat_admins_with_invite_links()<a class=\"headerlink\" href=\"#get-chat-admins-with-invite-links\" title=\"Link to this heading\">\u00b6</a></h1>\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.Client.get_chat_admins_with_invite_links\">\n<span class=\"sig-prename descclassname\"><span class=\"pre\">Client.</span></span><span class=\"sig-name descname\"><span class=\"pre\">get_chat_admins_with_invite_links</span></span><span class=\"sig-paren\">(</span><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#pyrogram.Client.get_chat_admins_with_invite_links\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Get the list of the administrators that have exported invite links in a chat.</p>\n<p>You must be the owner of a chat for this to work.</p>\n<strong>Usable by</strong>\n<span class=\"usable-by\"><i class=\"fa-solid fa-check\" style=\"color: var(--color-green)\"></i> Users</span>\n<span class=\"usable-by\"><i class=\"fa-solid fa-xmark\" style=\"color: var(--color-red)\"></i> Bots</span><dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p><strong>chat_id</strong> (<code class=\"docutils literal notranslate\"><span class=\"pre\">int</span></code> | <code class=\"docutils literal notranslate\"><span class=\"pre\">str</span></code>) \u2013 Unique identifier for the target chat or username of the target channel/supergroup\n(in the format &#64;username).</p>\n</dd>\n<dt class=\"field-even\">Returns<span class=\"colon\">:</span></dt>\n<dd class=\"field-even\"><p>List of <code class=\"xref py py-obj docutils literal notranslate\"><span class=\"pre\">ChatAdminWithInviteLink</span></code> \u2013 On success, the list of admins that have exported\ninvite links is returned.</p>\n</dd>\n</dl>\n</dd></dl>\n\n</section>\n", "metatags": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n", "rellinks": [["genindex", "General Index", "I", "index"], ["py-modindex", "Python Module Index", "", "modules"], ["api/methods/get_chat_invite_link", "get_chat_invite_link()", "N", "next"], ["api/methods/get_chat_admin_invite_links_count", "get_chat_admin_invite_links_count()", "P", "previous"]], "sourcename": "", "toc": "<ul>\n<li><a class=\"reference internal\" href=\"#\">get_chat_admins_with_invite_links()</a><ul>\n<li><a class=\"reference internal\" href=\"#pyrogram.Client.get_chat_admins_with_invite_links\"><code class=\"docutils literal notranslate\"><span class=\"pre\">Client.get_chat_admins_with_invite_links()</span></code></a></li>\n</ul>\n</li>\n</ul>\n", "display_toc": true, "page_source_suffix": ".rst", "current_page_name": "api/methods/get_chat_admins_with_invite_links", "sidebars": ["sidebar/brand.html", "sidebar/search.html", "sidebar/scroll-start.html", "sidebar/navigation.html", "sidebar/scroll-end.html"], "alabaster_version": "1.0.0", "alabaster_version_info": [1, 0, 0], "furo_version": "2025.12.19", "furo_navigation_tree": "", "furo_hide_toc": false, "furo_pygments": {"light": {"background": "#eeffcc", "foreground": "black"}, "dark": {"background": "#202020", "foreground": "#d0d0d0"}}}