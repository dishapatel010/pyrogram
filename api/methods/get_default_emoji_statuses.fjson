{"parents": [{"link": "../", "title": "Available Methods"}], "prev": {"link": "../get_common_chats/", "title": "get_common_chats()"}, "next": {"link": "../set_emoji_status/", "title": "set_emoji_status()"}, "title": "get_default_emoji_statuses()", "meta": null, "body": "<section id=\"get-default-emoji-statuses\">\n<h1>get_default_emoji_statuses()<a class=\"headerlink\" href=\"#get-default-emoji-statuses\" title=\"Link to this heading\">\u00b6</a></h1>\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.Client.get_default_emoji_statuses\">\n<span class=\"sig-prename descclassname\"><span class=\"pre\">Client.</span></span><span class=\"sig-name descname\"><span class=\"pre\">get_default_emoji_statuses</span></span><span class=\"sig-paren\">(</span><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#pyrogram.Client.get_default_emoji_statuses\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Get the default emoji statuses.</p>\n<strong>Usable by</strong>\n<span class=\"usable-by\"><i class=\"fa-solid fa-check\" style=\"color: var(--color-green)\"></i> Users</span>\n<span class=\"usable-by\"><i class=\"fa-solid fa-xmark\" style=\"color: var(--color-red)\"></i> Bots</span><dl class=\"field-list simple\">\n<dt class=\"field-odd\">Returns<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p>List of <a class=\"reference internal\" href=\"../../types/EmojiStatus/#pyrogram.types.EmojiStatus\" title=\"pyrogram.types.EmojiStatus\"><code class=\"xref py py-obj docutils literal notranslate\"><span class=\"pre\">EmojiStatus</span></code></a> \u2013 On success, a list of emoji statuses is returned.</p>\n</dd>\n</dl>\n<p class=\"rubric\">Example</p>\n<div class=\"highlight-python notranslate\"><div class=\"highlight\"><pre><span></span><span class=\"n\">default_emoji_statuses</span> <span class=\"o\">=</span> <span class=\"k\">await</span> <span class=\"n\">app</span><span class=\"o\">.</span><span class=\"n\">get_default_emoji_statuses</span><span class=\"p\">()</span>\n<span class=\"nb\">print</span><span class=\"p\">(</span><span class=\"n\">default_emoji_statuses</span><span class=\"p\">)</span>\n</pre></div>\n</div>\n</dd></dl>\n\n</section>\n", "metatags": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n", "rellinks": [["genindex", "General Index", "I", "index"], ["py-modindex", "Python Module Index", "", "modules"], ["api/methods/set_emoji_status", "set_emoji_status()", "N", "next"], ["api/methods/get_common_chats", "get_common_chats()", "P", "previous"]], "sourcename": "", "toc": "<ul>\n<li><a class=\"reference internal\" href=\"#\">get_default_emoji_statuses()</a><ul>\n<li><a class=\"reference internal\" href=\"#pyrogram.Client.get_default_emoji_statuses\"><code class=\"docutils literal notranslate\"><span class=\"pre\">Client.get_default_emoji_statuses()</span></code></a></li>\n</ul>\n</li>\n</ul>\n", "display_toc": true, "page_source_suffix": ".rst", "current_page_name": "api/methods/get_default_emoji_statuses", "sidebars": ["sidebar/brand.html", "sidebar/search.html", "sidebar/scroll-start.html", "sidebar/navigation.html", "sidebar/scroll-end.html"], "alabaster_version": "1.0.0", "alabaster_version_info": [1, 0, 0], "furo_version": "2025.12.19", "furo_navigation_tree": "", "furo_hide_toc": false, "furo_pygments": {"light": {"background": "#eeffcc", "foreground": "black"}, "dark": {"background": "#202020", "foreground": "#d0d0d0"}}}