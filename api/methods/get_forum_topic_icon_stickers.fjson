{"parents": [{"link": "../", "title": "Available Methods"}], "prev": {"link": "../decline_all_chat_join_requests/", "title": "decline_all_chat_join_requests()"}, "next": {"link": "../create_forum_topic/", "title": "create_forum_topic()"}, "title": "get_forum_topic_icon_stickers()", "meta": null, "body": "<section id=\"get-forum-topic-icon-stickers\">\n<h1>get_forum_topic_icon_stickers()<a class=\"headerlink\" href=\"#get-forum-topic-icon-stickers\" title=\"Link to this heading\">\u00b6</a></h1>\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.Client.get_forum_topic_icon_stickers\">\n<span class=\"sig-prename descclassname\"><span class=\"pre\">Client.</span></span><span class=\"sig-name descname\"><span class=\"pre\">get_forum_topic_icon_stickers</span></span><span class=\"sig-paren\">(</span><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#pyrogram.Client.get_forum_topic_icon_stickers\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Use this method to get custom emoji stickers, which can be used as a forum topic icon by any user.</p>\n<strong>Usable by</strong>\n<span class=\"usable-by\"><i class=\"fa-solid fa-check\" style=\"color: var(--color-green)\"></i> Users</span>\n<span class=\"usable-by\"><i class=\"fa-solid fa-check\" style=\"color: var(--color-green)\"></i> Bots</span><dl class=\"field-list simple\">\n<dt class=\"field-odd\">Returns<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p>List of <a class=\"reference internal\" href=\"../../types/Sticker/#pyrogram.types.Sticker\" title=\"pyrogram.types.Sticker\"><code class=\"xref py py-obj docutils literal notranslate\"><span class=\"pre\">Sticker</span></code></a> \u2013 On success, a list of sticker objects is returned.</p>\n</dd>\n</dl>\n</dd></dl>\n\n</section>\n", "metatags": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n", "rellinks": [["genindex", "General Index", "I", "index"], ["py-modindex", "Python Module Index", "", "modules"], ["api/methods/create_forum_topic", "create_forum_topic()", "N", "next"], ["api/methods/decline_all_chat_join_requests", "decline_all_chat_join_requests()", "P", "previous"]], "sourcename": "", "toc": "<ul>\n<li><a class=\"reference internal\" href=\"#\">get_forum_topic_icon_stickers()</a><ul>\n<li><a class=\"reference internal\" href=\"#pyrogram.Client.get_forum_topic_icon_stickers\"><code class=\"docutils literal notranslate\"><span class=\"pre\">Client.get_forum_topic_icon_stickers()</span></code></a></li>\n</ul>\n</li>\n</ul>\n", "display_toc": true, "page_source_suffix": ".rst", "current_page_name": "api/methods/get_forum_topic_icon_stickers", "sidebars": ["sidebar/brand.html", "sidebar/search.html", "sidebar/scroll-start.html", "sidebar/navigation.html", "sidebar/scroll-end.html"], "alabaster_version": "1.0.0", "alabaster_version_info": [1, 0, 0], "furo_version": "2025.12.19", "furo_navigation_tree": "", "furo_hide_toc": false, "furo_pygments": {"light": {"background": "#eeffcc", "foreground": "black"}, "dark": {"background": "#202020", "foreground": "#d0d0d0"}}}