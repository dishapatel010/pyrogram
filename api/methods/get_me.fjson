{"parents": [{"link": "../", "title": "Available Methods"}], "prev": {"link": "../terminate/", "title": "terminate()"}, "next": {"link": "../get_active_sessions/", "title": "get_active_sessions()"}, "title": "get_me()", "meta": null, "body": "<section id=\"get-me\">\n<h1>get_me()<a class=\"headerlink\" href=\"#get-me\" title=\"Link to this heading\">\u00b6</a></h1>\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.Client.get_me\">\n<span class=\"sig-prename descclassname\"><span class=\"pre\">Client.</span></span><span class=\"sig-name descname\"><span class=\"pre\">get_me</span></span><span class=\"sig-paren\">(</span><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#pyrogram.Client.get_me\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Get your own user identity.</p>\n<strong>Usable by</strong>\n<span class=\"usable-by\"><i class=\"fa-solid fa-check\" style=\"color: var(--color-green)\"></i> Users</span>\n<span class=\"usable-by\"><i class=\"fa-solid fa-check\" style=\"color: var(--color-green)\"></i> Bots</span><dl class=\"field-list simple\">\n<dt class=\"field-odd\">Returns<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p><a class=\"reference internal\" href=\"../../types/User/#pyrogram.types.User\" title=\"pyrogram.types.User\"><code class=\"xref py py-obj docutils literal notranslate\"><span class=\"pre\">User</span></code></a> \u2013 Information about the own logged in user/bot.</p>\n</dd>\n</dl>\n<p class=\"rubric\">Example</p>\n<div class=\"highlight-python notranslate\"><div class=\"highlight\"><pre><span></span><span class=\"n\">me</span> <span class=\"o\">=</span> <span class=\"k\">await</span> <span class=\"n\">app</span><span class=\"o\">.</span><span class=\"n\">get_me</span><span class=\"p\">()</span>\n<span class=\"nb\">print</span><span class=\"p\">(</span><span class=\"n\">me</span><span class=\"p\">)</span>\n</pre></div>\n</div>\n</dd></dl>\n\n</section>\n", "metatags": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n", "rellinks": [["genindex", "General Index", "I", "index"], ["py-modindex", "Python Module Index", "", "modules"], ["api/methods/get_active_sessions", "get_active_sessions()", "N", "next"], ["api/methods/terminate", "terminate()", "P", "previous"]], "sourcename": "", "toc": "<ul>\n<li><a class=\"reference internal\" href=\"#\">get_me()</a><ul>\n<li><a class=\"reference internal\" href=\"#pyrogram.Client.get_me\"><code class=\"docutils literal notranslate\"><span class=\"pre\">Client.get_me()</span></code></a></li>\n</ul>\n</li>\n</ul>\n", "display_toc": true, "page_source_suffix": ".rst", "current_page_name": "api/methods/get_me", "sidebars": ["sidebar/brand.html", "sidebar/search.html", "sidebar/scroll-start.html", "sidebar/navigation.html", "sidebar/scroll-end.html"], "alabaster_version": "1.0.0", "alabaster_version_info": [1, 0, 0], "furo_version": "2025.12.19", "furo_navigation_tree": "", "furo_hide_toc": false, "furo_pygments": {"light": {"background": "#eeffcc", "foreground": "black"}, "dark": {"background": "#202020", "foreground": "#d0d0d0"}}}