{"parents": [{"link": "../", "title": "Available Methods"}], "prev": {"link": "../get_available_gifts/", "title": "get_available_gifts()"}, "next": {"link": "../get_business_account_star_balance/", "title": "get_business_account_star_balance()"}, "title": "get_owned_star_count()", "meta": null, "body": "<section id=\"get-owned-star-count\">\n<h1>get_owned_star_count()<a class=\"headerlink\" href=\"#get-owned-star-count\" title=\"Link to this heading\">\u00b6</a></h1>\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.Client.get_owned_star_count\">\n<span class=\"sig-prename descclassname\"><span class=\"pre\">Client.</span></span><span class=\"sig-name descname\"><span class=\"pre\">get_owned_star_count</span></span><span class=\"sig-paren\">(</span><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#pyrogram.Client.get_owned_star_count\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Get the number of Telegram Stars count owned by the current account or the specified bot.</p>\n<strong>Usable by</strong>\n<span class=\"usable-by\"><i class=\"fa-solid fa-check\" style=\"color: var(--color-green)\"></i> Users</span>\n<span class=\"usable-by\"><i class=\"fa-solid fa-xmark\" style=\"color: var(--color-red)\"></i> Bots</span><dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p><strong>user_id</strong> (<code class=\"docutils literal notranslate\"><span class=\"pre\">int</span></code> | <code class=\"docutils literal notranslate\"><span class=\"pre\">str</span></code>, <em>optional</em>) \u2013 Unique identifier (int) or username (str) of the bot for which the star count should be returned instead of the current user.\nThe bot should have <code class=\"docutils literal notranslate\"><span class=\"pre\">can_be_edited</span></code> property set to True.\nPass <code class=\"docutils literal notranslate\"><span class=\"pre\">None</span></code> to return the count of the current user.</p>\n</dd>\n<dt class=\"field-even\">Returns<span class=\"colon\">:</span></dt>\n<dd class=\"field-even\"><p><a class=\"reference internal\" href=\"../../types/StarAmount/#pyrogram.types.StarAmount\" title=\"pyrogram.types.StarAmount\"><code class=\"xref py py-obj docutils literal notranslate\"><span class=\"pre\">StarAmount</span></code></a> \u2013 On success, the current stars balance is returned.</p>\n</dd>\n</dl>\n<p class=\"rubric\">Example</p>\n<div class=\"highlight-python notranslate\"><div class=\"highlight\"><pre><span></span><span class=\"c1\"># Get stars balance</span>\n<span class=\"n\">app</span><span class=\"o\">.</span><span class=\"n\">get_stars_balance</span><span class=\"p\">()</span>\n\n<span class=\"c1\"># Get stars balance of a bot owned by the current user</span>\n<span class=\"n\">app</span><span class=\"o\">.</span><span class=\"n\">get_stars_balance</span><span class=\"p\">(</span><span class=\"n\">user_id</span><span class=\"o\">=</span><span class=\"s2\">&quot;pyrogrambot&quot;</span><span class=\"p\">)</span>\n</pre></div>\n</div>\n</dd></dl>\n\n</section>\n", "metatags": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n", "rellinks": [["genindex", "General Index", "I", "index"], ["py-modindex", "Python Module Index", "", "modules"], ["api/methods/get_business_account_star_balance", "get_business_account_star_balance()", "N", "next"], ["api/methods/get_available_gifts", "get_available_gifts()", "P", "previous"]], "sourcename": "", "toc": "<ul>\n<li><a class=\"reference internal\" href=\"#\">get_owned_star_count()</a><ul>\n<li><a class=\"reference internal\" href=\"#pyrogram.Client.get_owned_star_count\"><code class=\"docutils literal notranslate\"><span class=\"pre\">Client.get_owned_star_count()</span></code></a></li>\n</ul>\n</li>\n</ul>\n", "display_toc": true, "page_source_suffix": ".rst", "current_page_name": "api/methods/get_owned_star_count", "sidebars": ["sidebar/brand.html", "sidebar/search.html", "sidebar/scroll-start.html", "sidebar/navigation.html", "sidebar/scroll-end.html"], "alabaster_version": "1.0.0", "alabaster_version_info": [1, 0, 0], "furo_version": "2025.12.19", "furo_navigation_tree": "", "furo_hide_toc": false, "furo_pygments": {"light": {"background": "#eeffcc", "foreground": "black"}, "dark": {"background": "#202020", "foreground": "#d0d0d0"}}}