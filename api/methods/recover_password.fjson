{"parents": [{"link": "../", "title": "Available Methods"}], "prev": {"link": "../resend_code/", "title": "resend_code()"}, "next": {"link": "../send_recovery_code/", "title": "send_recovery_code()"}, "title": "recover_password()", "meta": null, "body": "<section id=\"recover-password\">\n<h1>recover_password()<a class=\"headerlink\" href=\"#recover-password\" title=\"Link to this heading\">\u00b6</a></h1>\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.Client.recover_password\">\n<span class=\"sig-prename descclassname\"><span class=\"pre\">Client.</span></span><span class=\"sig-name descname\"><span class=\"pre\">recover_password</span></span><span class=\"sig-paren\">(</span><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#pyrogram.Client.recover_password\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Recover your password with a recovery code and log in.</p>\n<strong>Usable by</strong>\n<span class=\"usable-by\"><i class=\"fa-solid fa-check\" style=\"color: var(--color-green)\"></i> Users</span>\n<span class=\"usable-by\"><i class=\"fa-solid fa-xmark\" style=\"color: var(--color-red)\"></i> Bots</span><dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p><strong>recovery_code</strong> (<code class=\"docutils literal notranslate\"><span class=\"pre\">str</span></code>) \u2013 The recovery code sent via email.</p>\n</dd>\n<dt class=\"field-even\">Returns<span class=\"colon\">:</span></dt>\n<dd class=\"field-even\"><p><a class=\"reference internal\" href=\"../../types/User/#pyrogram.types.User\" title=\"pyrogram.types.User\"><code class=\"xref py py-obj docutils literal notranslate\"><span class=\"pre\">User</span></code></a> \u2013 On success, the authorized user is returned and the Two-Step Verification\npassword reset.</p>\n</dd>\n<dt class=\"field-odd\">Raises<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p><strong>BadRequest</strong> \u2013 In case the recovery code is invalid.</p>\n</dd>\n</dl>\n</dd></dl>\n\n</section>\n", "metatags": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n", "rellinks": [["genindex", "General Index", "I", "index"], ["py-modindex", "Python Module Index", "", "modules"], ["api/methods/send_recovery_code", "send_recovery_code()", "N", "next"], ["api/methods/resend_code", "resend_code()", "P", "previous"]], "sourcename": "", "toc": "<ul>\n<li><a class=\"reference internal\" href=\"#\">recover_password()</a><ul>\n<li><a class=\"reference internal\" href=\"#pyrogram.Client.recover_password\"><code class=\"docutils literal notranslate\"><span class=\"pre\">Client.recover_password()</span></code></a></li>\n</ul>\n</li>\n</ul>\n", "display_toc": true, "page_source_suffix": ".rst", "current_page_name": "api/methods/recover_password", "sidebars": ["sidebar/brand.html", "sidebar/search.html", "sidebar/scroll-start.html", "sidebar/navigation.html", "sidebar/scroll-end.html"], "alabaster_version": "1.0.0", "alabaster_version_info": [1, 0, 0], "furo_version": "2025.12.19", "furo_navigation_tree": "", "furo_hide_toc": false, "furo_pygments": {"light": {"background": "#eeffcc", "foreground": "black"}, "dark": {"background": "#202020", "foreground": "#d0d0d0"}}}