{"parents": [{"link": "../", "title": "Available Methods"}], "prev": {"link": "../connect/", "title": "connect()"}, "next": {"link": "../resend_code/", "title": "resend_code()"}, "title": "send_code()", "meta": null, "body": "<section id=\"send-code\">\n<h1>send_code()<a class=\"headerlink\" href=\"#send-code\" title=\"Link to this heading\">\u00b6</a></h1>\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.Client.send_code\">\n<span class=\"sig-prename descclassname\"><span class=\"pre\">Client.</span></span><span class=\"sig-name descname\"><span class=\"pre\">send_code</span></span><span class=\"sig-paren\">(</span><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#pyrogram.Client.send_code\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Send the confirmation code to the given phone number.</p>\n<strong>Usable by</strong>\n<span class=\"usable-by\"><i class=\"fa-solid fa-check\" style=\"color: var(--color-green)\"></i> Users</span>\n<span class=\"usable-by\"><i class=\"fa-solid fa-xmark\" style=\"color: var(--color-red)\"></i> Bots</span><dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p><strong>phone_number</strong> (<code class=\"docutils literal notranslate\"><span class=\"pre\">str</span></code>) \u2013 Phone number in international format (includes the country prefix).</p>\n</dd>\n<dt class=\"field-even\">Returns<span class=\"colon\">:</span></dt>\n<dd class=\"field-even\"><p><a class=\"reference internal\" href=\"../../types/SentCode/#pyrogram.types.SentCode\" title=\"pyrogram.types.SentCode\"><code class=\"xref py py-obj docutils literal notranslate\"><span class=\"pre\">SentCode</span></code></a> \u2013 On success, an object containing information on the sent confirmation code\nis returned.</p>\n</dd>\n<dt class=\"field-odd\">Raises<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p><strong>BadRequest</strong> \u2013 In case the phone number is invalid.</p>\n</dd>\n</dl>\n</dd></dl>\n\n</section>\n", "metatags": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n", "rellinks": [["genindex", "General Index", "I", "index"], ["py-modindex", "Python Module Index", "", "modules"], ["api/methods/resend_code", "resend_code()", "N", "next"], ["api/methods/connect", "connect()", "P", "previous"]], "sourcename": "", "toc": "<ul>\n<li><a class=\"reference internal\" href=\"#\">send_code()</a><ul>\n<li><a class=\"reference internal\" href=\"#pyrogram.Client.send_code\"><code class=\"docutils literal notranslate\"><span class=\"pre\">Client.send_code()</span></code></a></li>\n</ul>\n</li>\n</ul>\n", "display_toc": true, "page_source_suffix": ".rst", "current_page_name": "api/methods/send_code", "sidebars": ["sidebar/brand.html", "sidebar/search.html", "sidebar/scroll-start.html", "sidebar/navigation.html", "sidebar/scroll-end.html"], "alabaster_version": "1.0.0", "alabaster_version_info": [1, 0, 0], "furo_version": "2025.12.19", "furo_navigation_tree": "", "furo_hide_toc": false, "furo_pygments": {"light": {"background": "#eeffcc", "foreground": "black"}, "dark": {"background": "#202020", "foreground": "#d0d0d0"}}}