{"parents": [{"link": "../", "title": "Available Methods"}], "prev": {"link": "../set_emoji_status/", "title": "set_emoji_status()"}, "next": {"link": "../set_personal_chat/", "title": "set_personal_chat()"}, "title": "set_birthdate()", "meta": null, "body": "<section id=\"set-birthdate\">\n<h1>set_birthdate()<a class=\"headerlink\" href=\"#set-birthdate\" title=\"Link to this heading\">\u00b6</a></h1>\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.Client.set_birthdate\">\n<span class=\"sig-prename descclassname\"><span class=\"pre\">Client.</span></span><span class=\"sig-name descname\"><span class=\"pre\">set_birthdate</span></span><span class=\"sig-paren\">(</span><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#pyrogram.Client.set_birthdate\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Changes the birthdate of the current user</p>\n<strong>Usable by</strong>\n<span class=\"usable-by\"><i class=\"fa-solid fa-check\" style=\"color: var(--color-green)\"></i> Users</span>\n<span class=\"usable-by\"><i class=\"fa-solid fa-xmark\" style=\"color: var(--color-red)\"></i> Bots</span><dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p><strong>birthdate</strong> (<a class=\"reference internal\" href=\"../../types/Birthdate/#pyrogram.types.Birthdate\" title=\"pyrogram.types.Birthdate\"><code class=\"xref py py-obj docutils literal notranslate\"><span class=\"pre\">Birthdate</span></code></a>, <em>optional</em>) \u2013 The new value of the current user\u2019s birthdate; pass None to remove the birthdate</p>\n</dd>\n<dt class=\"field-even\">Returns<span class=\"colon\">:</span></dt>\n<dd class=\"field-even\"><p><code class=\"docutils literal notranslate\"><span class=\"pre\">bool</span></code> \u2013 True on success.</p>\n</dd>\n</dl>\n<p class=\"rubric\">Example</p>\n<div class=\"highlight-python notranslate\"><div class=\"highlight\"><pre><span></span><span class=\"c1\"># Update your birthdate</span>\n<span class=\"k\">await</span> <span class=\"n\">app</span><span class=\"o\">.</span><span class=\"n\">set_birthdate</span><span class=\"p\">(</span><span class=\"n\">birthdate</span><span class=\"o\">=</span><span class=\"n\">types</span><span class=\"o\">.</span><span class=\"n\">Birthdate</span><span class=\"p\">(</span>\n    <span class=\"n\">day</span><span class=\"o\">=</span><span class=\"mi\">15</span><span class=\"p\">,</span>\n    <span class=\"n\">month</span><span class=\"o\">=</span><span class=\"mi\">12</span><span class=\"p\">,</span>\n    <span class=\"n\">year</span><span class=\"o\">=</span><span class=\"mi\">2017</span>\n<span class=\"p\">))</span>\n\n<span class=\"c1\"># Remove your birthdate</span>\n<span class=\"k\">await</span> <span class=\"n\">app</span><span class=\"o\">.</span><span class=\"n\">set_birthdate</span><span class=\"p\">()</span>\n</pre></div>\n</div>\n</dd></dl>\n\n</section>\n", "metatags": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n", "rellinks": [["genindex", "General Index", "I", "index"], ["py-modindex", "Python Module Index", "", "modules"], ["api/methods/set_personal_chat", "set_personal_chat()", "N", "next"], ["api/methods/set_emoji_status", "set_emoji_status()", "P", "previous"]], "sourcename": "", "toc": "<ul>\n<li><a class=\"reference internal\" href=\"#\">set_birthdate()</a><ul>\n<li><a class=\"reference internal\" href=\"#pyrogram.Client.set_birthdate\"><code class=\"docutils literal notranslate\"><span class=\"pre\">Client.set_birthdate()</span></code></a></li>\n</ul>\n</li>\n</ul>\n", "display_toc": true, "page_source_suffix": ".rst", "current_page_name": "api/methods/set_birthdate", "sidebars": ["sidebar/brand.html", "sidebar/search.html", "sidebar/scroll-start.html", "sidebar/navigation.html", "sidebar/scroll-end.html"], "alabaster_version": "1.0.0", "alabaster_version_info": [1, 0, 0], "furo_version": "2025.12.19", "furo_navigation_tree": "", "furo_hide_toc": false, "furo_pygments": {"light": {"background": "#eeffcc", "foreground": "black"}, "dark": {"background": "#202020", "foreground": "#d0d0d0"}}}