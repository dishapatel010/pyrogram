{"parents": [{"link": "../", "title": "Available Methods"}], "prev": {"link": "../get_default_emoji_statuses/", "title": "get_default_emoji_statuses()"}, "next": {"link": "../set_birthdate/", "title": "set_birthdate()"}, "title": "set_emoji_status()", "meta": null, "body": "<section id=\"set-emoji-status\">\n<h1>set_emoji_status()<a class=\"headerlink\" href=\"#set-emoji-status\" title=\"Link to this heading\">\u00b6</a></h1>\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.Client.set_emoji_status\">\n<span class=\"sig-prename descclassname\"><span class=\"pre\">Client.</span></span><span class=\"sig-name descname\"><span class=\"pre\">set_emoji_status</span></span><span class=\"sig-paren\">(</span><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#pyrogram.Client.set_emoji_status\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Set the emoji status.</p>\n<strong>Usable by</strong>\n<span class=\"usable-by\"><i class=\"fa-solid fa-check\" style=\"color: var(--color-green)\"></i> Users</span>\n<span class=\"usable-by\"><i class=\"fa-solid fa-xmark\" style=\"color: var(--color-red)\"></i> Bots</span><dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p><strong>emoji_status</strong> (<a class=\"reference internal\" href=\"../../types/EmojiStatus/#pyrogram.types.EmojiStatus\" title=\"pyrogram.types.EmojiStatus\"><code class=\"xref py py-obj docutils literal notranslate\"><span class=\"pre\">EmojiStatus</span></code></a>, <em>optional</em>) \u2013 The emoji status to set. None to remove.</p>\n</dd>\n<dt class=\"field-even\">Returns<span class=\"colon\">:</span></dt>\n<dd class=\"field-even\"><p><code class=\"docutils literal notranslate\"><span class=\"pre\">bool</span></code> \u2013 On success, True is returned.</p>\n</dd>\n</dl>\n<p class=\"rubric\">Example</p>\n<div class=\"highlight-python notranslate\"><div class=\"highlight\"><pre><span></span><span class=\"kn\">from</span><span class=\"w\"> </span><span class=\"nn\">pyrogram</span><span class=\"w\"> </span><span class=\"kn\">import</span> <span class=\"n\">types</span>\n\n<span class=\"k\">await</span> <span class=\"n\">app</span><span class=\"o\">.</span><span class=\"n\">set_emoji_status</span><span class=\"p\">(</span><span class=\"n\">types</span><span class=\"o\">.</span><span class=\"n\">EmojiStatus</span><span class=\"p\">(</span><span class=\"n\">custom_emoji_id</span><span class=\"o\">=</span><span class=\"mi\">1234567890987654321</span><span class=\"p\">))</span>\n</pre></div>\n</div>\n</dd></dl>\n\n</section>\n", "metatags": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n", "rellinks": [["genindex", "General Index", "I", "index"], ["py-modindex", "Python Module Index", "", "modules"], ["api/methods/set_birthdate", "set_birthdate()", "N", "next"], ["api/methods/get_default_emoji_statuses", "get_default_emoji_statuses()", "P", "previous"]], "sourcename": "", "toc": "<ul>\n<li><a class=\"reference internal\" href=\"#\">set_emoji_status()</a><ul>\n<li><a class=\"reference internal\" href=\"#pyrogram.Client.set_emoji_status\"><code class=\"docutils literal notranslate\"><span class=\"pre\">Client.set_emoji_status()</span></code></a></li>\n</ul>\n</li>\n</ul>\n", "display_toc": true, "page_source_suffix": ".rst", "current_page_name": "api/methods/set_emoji_status", "sidebars": ["sidebar/brand.html", "sidebar/search.html", "sidebar/scroll-start.html", "sidebar/navigation.html", "sidebar/scroll-end.html"], "alabaster_version": "1.0.0", "alabaster_version_info": [1, 0, 0], "furo_version": "2025.12.19", "furo_navigation_tree": "", "furo_hide_toc": false, "furo_pygments": {"light": {"background": "#eeffcc", "foreground": "black"}, "dark": {"background": "#202020", "foreground": "#d0d0d0"}}}