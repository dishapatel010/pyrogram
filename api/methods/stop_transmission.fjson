{"parents": [{"link": "../", "title": "Available Methods"}], "prev": {"link": "../remove_handler/", "title": "remove_handler()"}, "next": {"link": "../set_parse_mode/", "title": "set_parse_mode()"}, "title": "stop_transmission()", "meta": null, "body": "<section id=\"stop-transmission\">\n<h1>stop_transmission()<a class=\"headerlink\" href=\"#stop-transmission\" title=\"Link to this heading\">\u00b6</a></h1>\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.Client.stop_transmission\">\n<span class=\"sig-prename descclassname\"><span class=\"pre\">Client.</span></span><span class=\"sig-name descname\"><span class=\"pre\">stop_transmission</span></span><span class=\"sig-paren\">(</span><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#pyrogram.Client.stop_transmission\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Stop downloading or uploading a file.</p>\n<p>This method must be called inside a progress callback function in order to stop the transmission at the\ndesired time. The progress callback is called every time a file chunk is uploaded/downloaded.</p>\n<p class=\"rubric\">Example</p>\n<div class=\"highlight-python notranslate\"><div class=\"highlight\"><pre><span></span><span class=\"c1\"># Stop transmission once the upload progress reaches 50%</span>\n<span class=\"k\">async</span> <span class=\"k\">def</span><span class=\"w\"> </span><span class=\"nf\">progress</span><span class=\"p\">(</span><span class=\"n\">current</span><span class=\"p\">,</span> <span class=\"n\">total</span><span class=\"p\">,</span> <span class=\"n\">client</span><span class=\"p\">):</span>\n    <span class=\"k\">if</span> <span class=\"p\">(</span><span class=\"n\">current</span> <span class=\"o\">*</span> <span class=\"mi\">100</span> <span class=\"o\">/</span> <span class=\"n\">total</span><span class=\"p\">)</span> <span class=\"o\">&gt;</span> <span class=\"mi\">50</span><span class=\"p\">:</span>\n        <span class=\"n\">client</span><span class=\"o\">.</span><span class=\"n\">stop_transmission</span><span class=\"p\">()</span>\n\n<span class=\"k\">async</span> <span class=\"k\">with</span> <span class=\"n\">app</span><span class=\"p\">:</span>\n    <span class=\"k\">await</span> <span class=\"n\">app</span><span class=\"o\">.</span><span class=\"n\">send_document</span><span class=\"p\">(</span>\n        <span class=\"s2\">&quot;me&quot;</span><span class=\"p\">,</span> <span class=\"s2\">&quot;file.zip&quot;</span><span class=\"p\">,</span>\n        <span class=\"n\">progress</span><span class=\"o\">=</span><span class=\"n\">progress</span><span class=\"p\">,</span>\n        <span class=\"n\">progress_args</span><span class=\"o\">=</span><span class=\"p\">(</span><span class=\"n\">app</span><span class=\"p\">,))</span>\n</pre></div>\n</div>\n</dd></dl>\n\n</section>\n", "metatags": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n", "rellinks": [["genindex", "General Index", "I", "index"], ["py-modindex", "Python Module Index", "", "modules"], ["api/methods/set_parse_mode", "set_parse_mode()", "N", "next"], ["api/methods/remove_handler", "remove_handler()", "P", "previous"]], "sourcename": "", "toc": "<ul>\n<li><a class=\"reference internal\" href=\"#\">stop_transmission()</a><ul>\n<li><a class=\"reference internal\" href=\"#pyrogram.Client.stop_transmission\"><code class=\"docutils literal notranslate\"><span class=\"pre\">Client.stop_transmission()</span></code></a></li>\n</ul>\n</li>\n</ul>\n", "display_toc": true, "page_source_suffix": ".rst", "current_page_name": "api/methods/stop_transmission", "sidebars": ["sidebar/brand.html", "sidebar/search.html", "sidebar/scroll-start.html", "sidebar/navigation.html", "sidebar/scroll-end.html"], "alabaster_version": "1.0.0", "alabaster_version_info": [1, 0, 0], "furo_version": "2025.12.19", "furo_navigation_tree": "", "furo_hide_toc": false, "furo_pygments": {"light": {"background": "#eeffcc", "foreground": "black"}, "dark": {"background": "#202020", "foreground": "#d0d0d0"}}}