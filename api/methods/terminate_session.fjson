{"parents": [{"link": "../", "title": "Available Methods"}], "prev": {"link": "../get_active_sessions/", "title": "get_active_sessions()"}, "next": {"link": "../terminate_all_other_sessions/", "title": "terminate_all_other_sessions()"}, "title": "terminate_session()", "meta": null, "body": "<section id=\"terminate-session\">\n<h1>terminate_session()<a class=\"headerlink\" href=\"#terminate-session\" title=\"Link to this heading\">\u00b6</a></h1>\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.Client.terminate_session\">\n<span class=\"sig-prename descclassname\"><span class=\"pre\">Client.</span></span><span class=\"sig-name descname\"><span class=\"pre\">terminate_session</span></span><span class=\"sig-paren\">(</span><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#pyrogram.Client.terminate_session\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Terminates a session of the current user.</p>\n<strong>Usable by</strong>\n<span class=\"usable-by\"><i class=\"fa-solid fa-check\" style=\"color: var(--color-green)\"></i> Users</span>\n<span class=\"usable-by\"><i class=\"fa-solid fa-xmark\" style=\"color: var(--color-red)\"></i> Bots</span><dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p><strong>session_id</strong> (<code class=\"docutils literal notranslate\"><span class=\"pre\">int</span></code>) \u2013 Session identifier.</p>\n</dd>\n<dt class=\"field-even\">Returns<span class=\"colon\">:</span></dt>\n<dd class=\"field-even\"><p><code class=\"docutils literal notranslate\"><span class=\"pre\">bool</span></code> \u2013 On success, in case the session is destroyed, True is returned. Otherwise, False is returned.</p>\n</dd>\n<dt class=\"field-odd\">Raises<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p><strong>RPCError</strong> \u2013 In case of a Telegram RPC error.</p>\n</dd>\n</dl>\n</dd></dl>\n\n</section>\n", "metatags": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n", "rellinks": [["genindex", "General Index", "I", "index"], ["py-modindex", "Python Module Index", "", "modules"], ["api/methods/terminate_all_other_sessions", "terminate_all_other_sessions()", "N", "next"], ["api/methods/get_active_sessions", "get_active_sessions()", "P", "previous"]], "sourcename": "", "toc": "<ul>\n<li><a class=\"reference internal\" href=\"#\">terminate_session()</a><ul>\n<li><a class=\"reference internal\" href=\"#pyrogram.Client.terminate_session\"><code class=\"docutils literal notranslate\"><span class=\"pre\">Client.terminate_session()</span></code></a></li>\n</ul>\n</li>\n</ul>\n", "display_toc": true, "page_source_suffix": ".rst", "current_page_name": "api/methods/terminate_session", "sidebars": ["sidebar/brand.html", "sidebar/search.html", "sidebar/scroll-start.html", "sidebar/navigation.html", "sidebar/scroll-end.html"], "alabaster_version": "1.0.0", "alabaster_version_info": [1, 0, 0], "furo_version": "2025.12.19", "furo_navigation_tree": "", "furo_hide_toc": false, "furo_pygments": {"light": {"background": "#eeffcc", "foreground": "black"}, "dark": {"background": "#202020", "foreground": "#d0d0d0"}}}