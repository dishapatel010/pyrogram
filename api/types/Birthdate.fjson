{"parents": [{"link": "../", "title": "Available Types"}], "prev": {"link": "../DraftMessage/", "title": "DraftMessage"}, "next": {"link": "../User/", "title": "User"}, "title": "Birthdate", "meta": null, "body": "<section id=\"birthdate\">\n<h1>Birthdate<a class=\"headerlink\" href=\"#birthdate\" title=\"Link to this heading\">\u00b6</a></h1>\n<dl class=\"py class\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.types.Birthdate\">\n<em class=\"property\"><span class=\"pre\">class</span><span class=\"w\"> </span></em><span class=\"sig-prename descclassname\"><span class=\"pre\">pyrogram.types.</span></span><span class=\"sig-name descname\"><span class=\"pre\">Birthdate</span></span><a class=\"headerlink\" href=\"#pyrogram.types.Birthdate\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><ul class=\"simple\">\n<li><p><strong>day</strong> (<code class=\"docutils literal notranslate\"><span class=\"pre\">int</span></code>) \u2013 Day of the user\u2019s birth; 1-31</p></li>\n<li><p><strong>month</strong> (<code class=\"docutils literal notranslate\"><span class=\"pre\">int</span></code>) \u2013 Month of the user\u2019s birth; 1-12</p></li>\n<li><p><strong>year</strong> (<code class=\"docutils literal notranslate\"><span class=\"pre\">int</span></code>, <em>optional</em>) \u2013 Year of the user\u2019s birth</p></li>\n</ul>\n</dd>\n</dl>\n</dd></dl>\n\n</section>\n", "metatags": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n", "rellinks": [["genindex", "General Index", "I", "index"], ["py-modindex", "Python Module Index", "", "modules"], ["api/types/User", "User", "N", "next"], ["api/types/DraftMessage", "DraftMessage", "P", "previous"]], "sourcename": "", "toc": "<ul>\n<li><a class=\"reference internal\" href=\"#\">Birthdate</a><ul>\n<li><a class=\"reference internal\" href=\"#pyrogram.types.Birthdate\"><