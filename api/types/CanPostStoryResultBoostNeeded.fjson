{"parents": [{"link": "../", "title": "Available Types"}], "prev": {"link": "../CanPostStoryResultPremiumNeeded/", "title": "CanPostStoryResultPremiumNeeded"}, "next": {"link": "../CanPostStoryResultActiveStoryLimitExceeded/", "title": "CanPostStoryResultActiveStoryLimitExceeded"}, "title": "CanPostStoryResultBoostNeeded", "meta": null, "body": "<section id=\"canpoststoryresultboostneeded\">\n<h1>CanPostStoryResultBoostNeeded<a class=\"headerlink\" href=\"#canpoststoryresultboostneeded\" title=\"Link to this heading\">\u00b6</a></h1>\n<dl class=\"py class\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.types.CanPostStoryResultBoostNeeded\">\n<em class=\"property\"><span class=\"pre\">class</span><span class=\"w\"> </span></em><span class=\"sig-prename descclassname\"><span class=\"pre\">pyrogram.types.</span></span><span class=\"sig-name descname\"><span class=\"pre\">CanPostStoryResultBoostNeeded</span></span><a class=\"headerlink\" href=\"#pyrogram.types.CanPostStoryResultBoostNeeded\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>The chat must be boosted first by Telegram Premium subscribers to post more stories.</p>\n<p>Call getChatBoostStatus to get current boost status of the chat.</p>\n</dd></dl>\n\n</section>\n", "metatags": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n", "rellinks": [["genindex", "General Index", "I", "index"], ["py-modindex", "Python Module Index", "", "modules"], ["api/types/CanPostStoryResultActiveStoryLimitExceeded", "CanPostStoryResultActiveStoryLimitExceeded", "N", "next"], ["api/types/CanPostStoryResultPremiumNeeded", "CanPostStoryResultPremiumNeeded", "P", "previous"]], "sourcename": "", "toc": "<ul>\n<li><a class=\"reference internal\" href=\"#\">CanPostStoryResultBoostNeeded</a><ul>\n<li><a class=\"reference internal\" href=\"#pyrogram.types.CanPostStoryResultBoostNeeded\"><code class=\"docutils literal notranslate\"><span class=\"pre\">CanPostStoryResultBoostNeeded</span></code></a></