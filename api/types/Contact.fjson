{"parents": [{"link": "../", "title": "Available Types"}], "prev": {"link": "../PaidMediaVideo/", "title": "PaidMediaVideo"}, "next": {"link": "../Dice/", "title": "Dice"}, "title": "Contact", "meta": null, "body": "<section id=\"contact\">\n<h1>Contact<a class=\"headerlink\" href=\"#contact\" title=\"Link to this heading\">\u00b6</a></h1>\n<dl class=\"py class\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.types.Contact\">\n<em class=\"property\"><span class=\"pre\">class</span><span class=\"w\"> </span></em><span class=\"sig-prename descclassname\"><span class=\"pre\">pyrogram.types.</span></span><span class=\"sig-name descname\"><span class=\"pre\">Contact</span></span><a class=\"headerlink\" href=\"#pyrogram.types.Contact\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>A phone contact.</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><ul class=\"simple\">\n<li><p><strong>phone_number</strong> (<code class=\"docutils literal notranslate\"><span class=\"pre\">str</span></code>) \u2013 Phone number of the user.</p></li>\n<li><p><strong>first_name</strong> (<code class=\"docutils literal notranslate\"><span class=\"pre\">str</span></code>) \u2013 First name of the user; 1-64 characters.</p></li>\n<li><p><strong>last_name</strong> (<code class=\"docutils literal notranslate\"><span class=\"pre\">str</span></code>, <em>optional</em>) \u2013 Last name of the user; 0-64 characters.</p></li>\n<li><p><strong>user_id</strong> (<code class=\"docutils literal notranslate\"><span class=\"pre\">int</span></code>, <em>optional</em>) \u2013 Contact\u2019s user identifier in Telegram.</p></li>\n<li><p><strong>vcard</strong> (<code class=\"docutils literal notranslate\"><span class=\"pre\">str</span></code>, <em>optional</em>) \u2013 Additional data about the user in a form of <a class=\"reference external\" href=\"https://en.wikipedia.org/wiki/VCard\">vCard</a>; 0-2048 bytes in length.</p></li>\n</ul>\n</dd>\n</dl>\n</dd></dl>\n\n</section>\n", "metatags": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n", "rellinks": [["genindex", "General Index", "I", "index"], ["py-modindex", "Python Module Index", "", "modules"], ["api/types/Dice", "Dice", "N", "next"], ["api/types/PaidMediaVideo", "PaidMediaVideo", "P", "previous"]], "sourcename": "", "toc": "<ul>\n<li><a class=\"reference internal\" href=\"#\">Contact</a><ul>\n<li><a class=\"reference internal\" href=\"#pyrogram.types.Contact\"><code class=\"docutils literal notranslate\"><span class=\"pre\">Contact</span></code></a></li>\n</ul>\n</li>\n</ul>\n", "display_toc": true, "page_source_suffix": ".rst", "current_page_name": "api/types/Contact", "sidebars": ["sidebar/brand.html", "sidebar/search.html", "sidebar/scroll-start.html", "sidebar/navigation.html", "sidebar/scroll-end.html"], "alabaster_version": "1.0.0", "alabaster_version_info": [1, 0, 0], "furo_version": "2025.12.19", "furo_navigation_tree": "", "furo_hide_toc": false, "furo_pygments": {"light": {"background": "#eeffcc", "foreground": "black"}, "dark": {"background": "#202020", "foreground": "#d0d0d0"}}}