{"parents": [{"link": "../", "title": "Available Types"}], "prev": {"link": "../Dialog/", "title": "Dialog"}, "next": {"link": "../GroupCallParticipant/", "title": "GroupCallParticipant"}, "title": "EmojiStatus", "meta": null, "body": "<section id=\"emojistatus\">\n<h1>EmojiStatus<a class=\"headerlink\" href=\"#emojistatus\" title=\"Link to this heading\">\u00b6</a></h1>\n<dl class=\"py class\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.types.EmojiStatus\">\n<em class=\"property\"><span class=\"pre\">class</span><span class=\"w\"> </span></em><span class=\"sig-prename descclassname\"><span class=\"pre\">pyrogram.types.</span></span><span class=\"sig-name descname\"><span class=\"pre\">EmojiStatus</span></span><a class=\"headerlink\" href=\"#pyrogram.types.EmojiStatus\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>A user emoji status.</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><ul class=\"simple\">\n<li><p><strong>custom_emoji_id</strong> (<code class=\"docutils literal notranslate\"><span class=\"pre\">int</span></code>) \u2013 Custom emoji id.</p></li>\n<li><p><strong>until_date</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3/library/datetime.html#datetime.datetime\" title=\"(in Python v3.14)\"><code class=\"xref py py-obj docutils literal notranslate\"><span class=\"pre\">datetime</span></code></a>, <em>optional</em>) \u2013 Valid until date.</p></li>\n</ul>\n</dd>\n</dl>\n</dd></dl>\n\n</section>\n", "metatags": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n", "rellinks": [["genindex", "General Index", "I", "index"], ["py-modindex", "Python Module Index", "", "modules"], ["api/types/GroupCallParticipant", "GroupCallParticipant", "N", "next"], ["api/types/Dialog", "Dialog", "P", "previous"]], "sourcename": "", "toc": "<ul>\n<li><a class=\"reference internal\" href=\"#\">EmojiStatus</a><ul>\n<li><a cl