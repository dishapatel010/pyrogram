{"parents": [{"link": "../", "title": "Available Types"}], "prev": {"link": "../ForumTopic/", "title": "ForumTopic"}, "next": {"link": "../ForumTopicClosed/", "title": "ForumTopicClosed"}, "title": "ForumTopicCreated", "meta": null, "body": "<section id=\"forumtopiccreated\">\n<h1>ForumTopicCreated<a class=\"headerlink\" href=\"#forumtopiccreated\" title=\"Link to this heading\">\u00b6</a></h1>\n<dl class=\"py class\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.types.ForumTopicCreated\">\n<em class=\"property\"><span class=\"pre\">class</span><span class=\"w\"> </span></em><span class=\"sig-prename descclassname\"><span class=\"pre\">pyrogram.types.</span></span><span class=\"sig-name descname\"><span class=\"pre\">ForumTopicCreated</span></span><a class=\"headerlink\" href=\"#pyrogram.types.ForumTopicCreated\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>This object represents a service message about a new forum topic created in the chat.</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><ul class=\"simple\">\n<li><p><strong>name</strong> (<code class=\"docutils literal notranslate\"><span class=\"pre\">str</span></code>) \u2013 Name of the topic</p></li>\n<li><p><strong>icon_color</strong> (<code class=\"docutils literal notranslate\"><span class=\"pre\">int</span></code>) \u2013 Color of the topic icon in RGB format</p></li>\n<li><p><strong>icon_custom_emoji_id</strong> (<code class=\"docutils literal notranslate\"><span class=\"pre\">str</span></code>, <em>optional</em>) \u2013 Unique identifier of the custom emoji shown as the topic icon</p></li>\n<li><p><strong>is_name_implicit</strong> (<code class=\"docutils literal notranslate\"><span class=\"pre\">bool</span></code>, <em>optional</em>) \u2013 True, if the name of the topic wasn\u2019t specified explicitly by its creator and likely needs to be changed by the bot.</p></li>\n</ul>\n</dd>\n</dl>\n</dd></dl>\n\n</section>\n", "metatags": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n", "rellinks": [["genindex", "General Index", "I", "index"], ["py-modindex", "Python Module Index", "", "modules"], ["api/types/ForumTopicClosed", "ForumTopicClosed", "N", "next"], ["api/types/ForumTopic", "ForumTopic", "P", "previous"]], "sourcename": "", "toc": "<ul>\n<li><a class=\"reference internal\" href=\"#\">ForumTopicCreated</a><ul>\n<li><a class=\"reference internal\" href=\"#pyrogram.types.ForumTopicCreated\"><code class=\"docutils literal notranslate\"><span class=\"pre\">ForumTopicCreated</span></code></a></li>\n</ul>\n</li>\n</ul>\n", "display_toc": true, "page_source_suffix": ".rst", "current_page_name": "api/types/ForumTopicCreated", "sidebars": ["sidebar/brand.html", "sidebar/search.html", "sidebar/scroll-start.html", "sidebar/navigation.html", "sidebar/scroll-end.html"], "alabaster_version": "1.0.0", "alabaster_version_info": [1, 0, 0], "furo_version": "2025.12.19", "furo_navigation_tree": "", "furo_hide_toc": false, "furo_pygments": {"light": {"background": "#eeffcc", "foreground": "black"}, "dark": {"background": "#202020", "foreground": "#d0d0d0"}}}