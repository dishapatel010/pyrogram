{"parents": [{"link": "../", "title": "Available Types"}], "prev": {"link": "../ForumTopicClosed/", "title": "ForumTopicClosed"}, "next": {"link": "../ForumTopicReopened/", "title": "ForumTopicReopened"}, "title": "ForumTopicEdited", "meta": null, "body": "<section id=\"forumtopicedited\">\n<h1>ForumTopicEdited<a class=\"headerlink\" href=\"#forumtopicedited\" title=\"Link to this heading\">\u00b6</a></h1>\n<dl class=\"py class\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.types.ForumTopicEdited\">\n<em class=\"property\"><span class=\"pre\">class</span><span class=\"w\"> </span></em><span class=\"sig-prename descclassname\"><span class=\"pre\">pyrogram.types.</span></span><span class=\"sig-name descname\"><span class=\"pre\">ForumTopicEdited</span></span><a class=\"headerlink\" href=\"#pyrogram.types.ForumTopicEdited\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>This object represents a service message about an edited forum topic.</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><ul class=\"simple\">\n<li><p><strong>name</strong> (<code class=\"docutils literal notranslate\"><span class=\"pre\">str</span></code>, <em>optional</em>) \u2013 New name of the topic, if it was edited</p></li>\n<li><p><strong>icon_custom_emoji_id</strong> (<code class=\"docutils literal notranslate\"><span class=\"pre\">str</span></code>, <em>optional</em>) \u2013 New identifier of the custom emoji shown as the topic icon, if it was edited; an empty string if the icon was removed</p></li>\n</ul>\n</dd>\n</dl>\n</dd></dl>\n\n</section>\n", "metatags": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n", "rellinks": [["genindex", "General Index", "I", "index"], ["py-modindex", "Python Module Index", "", "modules"], ["api/types/ForumTopicReopened", "ForumTopicReopened", "N", "next"], ["api/types/ForumTopicClosed", "ForumTopicClosed", "P", "previous"]], "sourcename": "", "toc": "<ul>\n<li><a class=\"reference internal\" href=\"#\">ForumTopicEdited</a><ul>\n<li><a class=\"reference internal\" href=\"#pyrogram.types.ForumTopicEdited\"><code class=\"docutils literal notranslate\"><span class=\"pre\">ForumTopicEdited</span></code></a></li>\n</ul>\n</li>\n</ul>\n", "display_toc": true, "page_source_suffix": ".rst", "current_page_name": "api/types/ForumTopicEdited", "sidebars": ["sidebar/brand.html", "sidebar/search.html", "sidebar/scroll-start.html", "sidebar/navigation.html", "sidebar/scroll-end.html"], "alabaster_version": "1.0.0", "alabaster_version_info": [1, 0, 0], "furo_version": "2025.12.19", "furo_navigation_tree": "", "furo_hide_toc": false, "furo_pygments": {"light": {"background": "#eeffcc", "foreground": "black"}, "dark": {"background": "#202020", "foreground": "#d0d0d0"}}}