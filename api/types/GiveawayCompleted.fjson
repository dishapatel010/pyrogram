{"parents": [{"link": "../", "title": "Available Types"}], "prev": {"link": "../GiveawayCreated/", "title": "GiveawayCreated"}, "next": {"link": "../GiveawayWinners/", "title": "GiveawayWinners"}, "title": "GiveawayCompleted", "meta": null, "body": "<section id=\"giveawaycompleted\">\n<h1>GiveawayCompleted<a class=\"headerlink\" href=\"#giveawaycompleted\" title=\"Link to this heading\">\u00b6</a></h1>\n<dl class=\"py class\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.types.GiveawayCompleted\">\n<em class=\"property\"><span class=\"pre\">class</span><span class=\"w\"> </span></em><span class=\"sig-prename descclassname\"><span class=\"pre\">pyrogram.types.</span></span><span class=\"sig-name descname\"><span class=\"pre\">GiveawayCompleted</span></span><a class=\"headerlink\" href=\"#pyrogram.types.GiveawayCompleted\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>This object represents a service message about the completion of a giveaway without public winners.</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><ul class=\"simple\">\n<li><p><strong>winner_count</strong> (<code class=\"docutils literal notranslate\"><span class=\"pre\">int</span></code>) \u2013 Number of winners in the giveaway</p></li>\n<li><p><strong>unclaimed_prize_count</strong> (<code class=\"docutils literal notranslate\"><span class=\"pre\">int</span></code>, <em>optional</em>) \u2013 Number of undistributed prizes</p></li>\n<li><p><strong>giveaway_message</strong> (<a class=\"reference internal\" href=\"../Message/#pyrogram.types.Message\" title=\"pyrogram.types.Message\"><code class=\"xref py py-obj docutils literal notranslate\"><span class=\"pre\">Message</span></code></a>, <em>optional</em>) \u2013 Message with the giveaway that was completed, if it wasn\u2019t deleted</p></li>\n<li><p><strong>is_star_giveaway</strong> (<code class=\"docutils literal notranslate\"><span class=\"pre\">bool</span></code>, <em>optional</em>) \u2013 True, if the giveaway is a Telegram Star giveaway. Otherwise, currently, the giveaway is a Telegram Premium giveaway.</p></li>\n</ul>\n</dd>\n</dl>\n</dd></dl>\n\n</section>\n", "metatags": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n", "rellinks": [["genindex", "General Index", "I", "index"], ["py-modindex", "Python Module Index", "", "modules"], ["api/types/GiveawayWinners", "GiveawayWinners", "N", "next"], ["api/types/GiveawayCreated", "GiveawayCreated", "P", "previous"]], "sourcename": "", "toc": "<ul>\n<li><a class=\"reference internal\" href=\"#\">GiveawayCompleted</a><ul>\n<li><a class=\"reference internal\" href=\"#pyrogram.types.GiveawayCompleted\"><code class=\"docutils literal notranslate\"><span class=\"pre\">GiveawayCompleted</span></code></a></li>\n</ul>\n</li>\n</ul>\n", "display_toc": true, "page_source_suffix": ".rst", "current_page_name": "api/types/GiveawayCompleted", "sidebars": ["sidebar/brand.html", "sidebar/search.html", "sidebar/scroll-start.html", "sidebar/navigation.html", "sidebar/scroll-end.html"], "alabaster_version": "1.0.0", "alabaster_version_info": [1, 0, 0], "furo_version": "2025.12.19", "furo_navigation_tree": "", "furo_hide_toc": false, "furo_pygments": {"light": {"background": "#eeffcc", "foreground": "black"}, "dark": {"background": "#202020", "foreground": "#d0d0d0"}}}