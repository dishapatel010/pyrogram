{"parents": [{"link": "../", "title": "Available Types"}], "prev": {"link": "../Giveaway/", "title": "Giveaway"}, "next": {"link": "../GiveawayCompleted/", "title": "GiveawayCompleted"}, "title": "GiveawayCreated", "meta": null, "body": "<section id=\"giveawaycreated\">\n<h1>GiveawayCreated<a class=\"headerlink\" href=\"#giveawaycreated\" title=\"Link to this heading\">\u00b6</a></h1>\n<dl class=\"py class\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.types.GiveawayCreated\">\n<em class=\"property\"><span class=\"pre\">class</span><span class=\"w\"> </span></em><span class=\"sig-prename descclassname\"><span class=\"pre\">pyrogram.types.</span></span><span class=\"sig-name descname\"><span class=\"pre\">GiveawayCreated</span></span><a class=\"headerlink\" href=\"#pyrogram.types.GiveawayCreated\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>This object represents a service message about the creation of a scheduled giveaway.</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p><strong>prize_star_count</strong> (<code class=\"docutils literal notranslate\"><span class=\"pre\">int</span></code>, <em>optional</em>) \u2013 The number of Telegram Stars to be split between giveaway winners; for Telegram Star giveaways only</p>\n</dd>\n</dl>\n</dd></dl>\n\n</section>\n", "metatags": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n", "rellinks": [["genindex", "General Index", "I", "index"], ["py-modindex", "Python Module Index", "", "modules"], ["api/types/GiveawayCompleted", "GiveawayCompleted", "N", "next"], ["api/types/Giveaway", "Giveaway", "P", "previous"]], "sourcename": "", "toc": "<ul>\n<li><a class=\"reference internal\" href=\"#\">GiveawayCreated</a><ul>\n<li><a class=\"reference internal\" href=\"#pyrogram.types.GiveawayCreated\"><code class=\"docutils literal notranslate\"><span class=\"pre\">GiveawayCreated</span></code></a></li>\n</ul