{"parents": [{"link": "../", "title": "Available Types"}], "prev": {"link": "../InlineQueryResultVenue/", "title": "InlineQueryResultVenue"}, "next": {"link": "../InputTextMessageContent/", "title": "InputTextMessageContent"}, "title": "InputMessageContent", "meta": null, "body": "<section id=\"inputmessagecontent\">\n<h1>InputMessageContent<a class=\"headerlink\" href=\"#inputmessagecontent\" title=\"Link to this heading\">\u00b6</a></h1>\n<dl class=\"py class\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.types.InputMessageContent\">\n<em class=\"property\"><span class=\"pre\">class</span><span class=\"w\"> </span></em><span class=\"sig-prename descclassname\"><span class=\"pre\">pyrogram.types.</span></span><span class=\"sig-name descname\"><span class=\"pre\">InputMessageContent</span></span><a class=\"headerlink\" href=\"#pyrogram.types.InputMessageContent\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Content of a message to be sent as a result of an inline query.</p>\n<p>Telegram clients currently support the following 5 types:</p>\n<ul class=\"simple\">\n<li><p><a class=\"reference internal\" href=\"../InputTextMessageContent/#pyrogram.types.InputTextMessageContent\" title=\"pyrogram.types.InputTextMessageContent\"><code class=\"xref py py-obj docutils literal notranslate\"><span class=\"pre\">InputTextMessageContent</span></code></a></p></li>\n<li><p><a class=\"reference internal\" href=\"../InputLocationMessageContent/#pyrogram.types.InputLocationMessageContent\" title=\"pyrogram.types.InputLocationMessageContent\"><code class=\"xref py py-obj docutils literal notranslate\"><span class=\"pre\">InputLocationMessageContent</span></code></a></p></li>\n<li><p><a class=\"reference internal\" href=\"../InputVenueMessageContent/#pyrogram.types.InputVenueMessageContent\" title=\"pyrogram.types.InputVenueMessageContent\"><code class=\"xref py py-obj docutils literal notranslate\"><span class=\"pre\">InputVenueMessageContent</span></code></a></p></li>\n<li><p><a class=\"reference internal\" href=\"../InputContactMessageContent/#pyrogram.types.InputContactMessageContent\" title=\"pyrogram.types.InputContactMessageContent\"><code class=\"xref py py-obj docutils literal notranslate\"><span class=\"pre\">InputContactMessageContent</span></code></a></p></li>\n<li><p><a class=\"reference internal\" href=\"../InputInvoiceMessageContent/#pyrogram.types.InputInvoiceMessageContent\" title=\"pyrogram.types.InputInvoiceMessageContent\"><code class=\"xref py py-obj docutils literal notranslate\"><span class=\"pre\">InputInvoiceMessageContent</span></code></a></p></li>\n</ul>\n</dd></dl>\n\n</section>\n", "metatags": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n", "rellinks": [["genindex", "General Index", "I", "index"], ["py-modindex", "Python Module Index", "", "modules"], ["api/types/InputTextMessageContent", "InputTextMessageContent", "N", "next"], ["api/types/InlineQueryResultVenue", "InlineQueryResultVenue", "P", "previous"]], "sourcename": "", "toc": "<ul>\n<li><a class=\"reference internal\" href=\"#\">InputMessageContent</a><ul>\n<li><a class=\"reference internal\" href=\"#pyrogram.types.InputMessageContent\"><code class=\"docutils literal notranslate\"><span class=\"pre\">InputMessageContent</span></code></a></li>\n</ul>\n</li>\n</ul>\n", "display_toc": true, "page_source_suffix": ".rst", "current_page_name": "api/types/InputMessageContent", "sidebars": ["sidebar/brand.html", "sidebar/search.html", "sidebar/scroll-start.html", "sidebar/navigation.html", "sidebar/scroll-end.html"], "alabaster_version": "1.0.0", "alabaster_version_info": [1, 0, 0], "furo_version": "2025.12.19", "furo_navigation_tree": "", "furo_hide_toc": false, "furo_pygments": {"light": {"background": "#eeffcc", "foreground": "black"}, "dark": {"background": "#202020", "foreground": "#d0d0d0"}}}