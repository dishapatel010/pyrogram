{"parents": [{"link": "../", "title": "Available Types"}], "prev": {"link": "../InputLocationMessageContent/", "title": "InputLocationMessageContent"}, "next": {"link": "../InputContactMessageContent/", "title": "InputContactMessageContent"}, "title": "InputVenueMessageContent", "meta": null, "body": "<section id=\"inputvenuemessagecontent\">\n<h1>InputVenueMessageContent<a class=\"headerlink\" href=\"#inputvenuemessagecontent\" title=\"Link to this heading\">\u00b6</a></h1>\n<dl class=\"py class\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.types.InputVenueMessageContent\">\n<em class=\"property\"><span class=\"pre\">class</span><span class=\"w\"> </span></em><span class=\"sig-prename descclassname\"><span class=\"pre\">pyrogram.types.</span></span><span class=\"sig-name descname\"><span class=\"pre\">InputVenueMessageContent</span></span><a class=\"headerlink\" href=\"#pyrogram.types.InputVenueMessageContent\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Content of a venue message to be sent as the result of an inline query.</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><ul class=\"simple\">\n<li><p><strong>latitude</strong> (<code class=\"docutils literal notranslate\"><span class=\"pre\">float</span></code>) \u2013 Latitude of the location.</p></li>\n<li><p><strong>longitude</strong> (<code class=\"docutils literal notranslate\"><span class=\"pre\">float</span></code>) \u2013 Longitude of the location.</p></li>\n<li><p><strong>title</strong> (<code class=\"docutils literal notranslate\"><span class=\"pre\">str</span></code>) \u2013 Name of the venue.</p></li>\n<li><p><strong>address</strong> (<code class=\"docutils literal notranslate\"><span class=\"pre\">str</span></code>) \u2013 Address of the venue.</p></li>\n<li><p><strong>foursquare_id</strong> (<code class=\"docutils literal notranslate\"><span class=\"pre\">str</span></code>, <em>optional</em>) \u2013 Foursquare identifier of the venue, if known.</p></li>\n<li><p><strong>foursquare_type</strong> (<code class=\"docutils literal notranslate\"><span class=\"pre\">str</span></code>, <em>optional</em>) \u2013 Foursquare type of the venue, if known. (For example, \u201carts_entertainment/default\u201d, \u201carts_entertainment/aquarium\u201d or \u201cfood/icecream\u201d.)</p></li>\n</ul>\n</dd>\n</dl>\n</dd></dl>\n\n</section>\n", "metatags": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n", "rellinks": [["genindex", "General Index", "I", "index"], ["py-modindex", "Python Module Index", "", "modules"], ["api/types/InputContactMessageContent", "InputContactMessageContent", "N", "next"], ["api/types/InputLocationMessageContent", "InputLocationMessageContent", "P", "previous"]], "sourcename": "", "toc": "<ul>\n<li><a class=\"reference internal\" href=\"#\">InputVenueMessageContent</a><ul>\n<li><a class=\"reference internal\" href=\"#pyrogram.types.InputVenueMessageContent\"><code class=\"docutils literal notranslate\"><span class=\"pre\">InputVenueMessageContent</span></code></a></li>\n</ul>\n</li>\n</ul>\n", "display_toc": true, "page_source_suffix": ".rst", "current_page_name": "api/types/InputVenueMessageContent", "sidebars": ["sidebar/brand.html", "sidebar/search.html", "sidebar/scroll-start.html", "sidebar/navigation.html", "sidebar/scroll-end.html"], "alabaster_version": "1.0.0", "alabaster_version_info": [1, 0, 0], "furo_version": "2025.12.19", "furo_navigation_tree": "", "furo_hide_toc": false, "furo_pygments": {"light": {"background": "#eeffcc", "foreground": "black"}, "dark": {"background": "#202020", "foreground": "#d0d0d0"}}}