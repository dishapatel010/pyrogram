{"parents": [{"link": "../", "title": "Available Types"}], "prev": {"link": "../ChecklistTasksAdded/", "title": "ChecklistTasksAdded"}, "next": {"link": "../Venue/", "title": "Venue"}, "title": "Location", "meta": null, "body": "<section id=\"location\">\n<h1>Location<a class=\"headerlink\" href=\"#location\" title=\"Link to this heading\">\u00b6</a></h1>\n<dl class=\"py class\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.types.Location\">\n<em class=\"property\"><span class=\"pre\">class</span><span class=\"w\"> </span></em><span class=\"sig-prename descclassname\"><span class=\"pre\">pyrogram.types.</span></span><span class=\"sig-name descname\"><span class=\"pre\">Location</span></span><a class=\"headerlink\" href=\"#pyrogram.types.Location\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>A point on the map.</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><ul class=\"simple\">\n<li><p><strong>longitude</strong> (<code class=\"docutils literal notranslate\"><span class=\"pre\">float</span></code>) \u2013 Longitude as defined by sender.</p></li>\n<li><p><strong>latitude</strong> (<code class=\"docutils literal notranslate\"><span class=\"pre\">float</span></code>) \u2013 Latitude as defined by sender.</p></li>\n</ul>\n</dd>\n</dl>\n</dd></dl>\n\n</section>\n", "metatags": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n", "rellinks": [["genindex", "General Index", "I", "index"], ["py-modindex", "Python Module Index", "", "modules"], ["api/types/Venue", "Venue", "N", "next"], ["api/types/ChecklistTasksAdded", "ChecklistTasksAdded", "P", "previous"]], "sourcename": "", "toc": "<ul>\n<li><a class=\"reference internal\" href=\"#\">Location</a><ul>\n<li><a class=\"reference internal\" href=\"#pyrogram.types.Location\"><code class=\"docutils literal notranslate\"><span class=\"pre\">Location</span></code></a></li>\n</ul>\n</li>\n</ul>\n", "dis