{"parents": [{"link": "../", "title": "Available Types"}], "prev": {"link": "../ShippingAddress/", "title": "ShippingAddress"}, "next": {"link": "../ShippingOption/", "title": "ShippingOption"}, "title": "OrderInfo", "meta": null, "body": "<section id=\"orderinfo\">\n<h1>OrderInfo<a class=\"headerlink\" href=\"#orderinfo\" title=\"Link to this heading\">\u00b6</a></h1>\n<dl class=\"py class\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.types.OrderInfo\">\n<em class=\"property\"><span class=\"pre\">class</span><span class=\"w\"> </span></em><span class=\"sig-prename descclassname\"><span class=\"pre\">pyrogram.types.</span></span><span class=\"sig-name descname\"><span class=\"pre\">OrderInfo</span></span><a class=\"headerlink\" href=\"#pyrogram.types.OrderInfo\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>This object represents information about an order.</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><ul class=\"simple\">\n<li><p><strong>name</strong> (<code class=\"docutils literal notranslate\"><span class=\"pre\">str</span></code>, <em>optional</em>) \u2013 User name.</p></li>\n<li><p><strong>phone_number</strong> (<code class=\"docutils literal notranslate\"><span class=\"pre\">str</span></code>, <em>optional</em>) \u2013 User\u2019s phone number.</p></li>\n<li><p><strong>email</strong> (<code class=\"docutils literal notranslate\"><span class=\"pre\">str</span></code>, <em>optional</em>) \u2013 User email.</p></li>\n<li><p><strong>shipping_address</strong> (<a class=\"reference internal\" href=\"../ShippingAddress/#pyrogram.types.ShippingAddress\" title=\"pyrogram.types.ShippingAddress\"><code class=\"xref py py-obj docutils literal notranslate\"><span class=\"pre\">ShippingAddress</span></code></a>, <em>optional</em>) \u2013 User shipping address.</p></li>\n</ul>\n</dd>\n</dl>\n</dd></dl>\n\n</section>\n", "metatags": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n", "rellinks": [["genindex", "General Index", "I", "index"], ["py-modindex", "Python Module Index", "", "modules"], ["api/types/ShippingOption", "ShippingOption", "N", "next"], ["api/types/ShippingAddress", "ShippingAddress", "P", "previous"]], "sourcename": "", "toc": "<ul>\n<li><a class=\"reference internal\" href=\"#\">OrderInfo</a><ul>\n<li><a class=\"reference internal\" href=\"#pyrogram.types.OrderInfo\"><code class=\"docutils literal notranslate\"><span class=\"pre\">OrderInfo</span></code></a></li>\n</ul>\n</li>\n</ul>\n", "display_toc": true, "page_source_suffix": ".rst", "current_page_name": "api/types/OrderInfo", "sidebars": ["sidebar/brand.html", "sidebar/search.html", "sidebar/scroll-start.html", "sidebar/navigation.html", "sidebar/scroll-end.html"], "alabaster_version": "1.0.0", "alabaster_version_info": [1, 0, 0], "furo_version": "2025.12.19", "furo_navigation_tree": "", "furo_hide_toc": false, "furo_pygments": {"light": {"background": "#eeffcc", "foreground": "black"}, "dark": {"background": "#202020", "foreground": "#d0d0d0"}}}