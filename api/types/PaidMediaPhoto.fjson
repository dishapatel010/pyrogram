{"parents": [{"link": "../", "title": "Available Types"}], "prev": {"link": "../PaidMediaPreview/", "title": "PaidMediaPreview"}, "next": {"link": "../PaidMediaVideo/", "title": "PaidMediaVideo"}, "title": "PaidMediaPhoto", "meta": null, "body": "<section id=\"paidmediaphoto\">\n<h1>PaidMediaPhoto<a class=\"headerlink\" href=\"#paidmediaphoto\" title=\"Link to this heading\">\u00b6</a></h1>\n<dl class=\"py class\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.types.PaidMediaPhoto\">\n<em class=\"property\"><span class=\"pre\">class</span><span class=\"w\"> </span></em><span class=\"sig-prename descclassname\"><span class=\"pre\">pyrogram.types.</span></span><span class=\"sig-name descname\"><span class=\"pre\">PaidMediaPhoto</span></span><a class=\"headerlink\" href=\"#pyrogram.types.PaidMediaPhoto\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>The paid media is a photo.</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p><strong>photo</strong> (<a class=\"reference internal\" href=\"../Photo/#pyrogram.types.Photo\" title=\"pyrogram.types.Photo\"><code class=\"xref py py-obj docutils literal notranslate\"><span class=\"pre\">Photo</span></code></a>) \u2013 The photo.</p>\n</dd>\n</dl>\n</dd></dl>\n\n</section>\n", "metatags": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n", "rellinks": [["genindex", "General Index", "I", "index"], ["py-modindex", "Python Module Index", "", "modules"], ["api/types/PaidMediaVideo", "PaidMediaVideo", "N", "next"], ["api/types/PaidMediaPreview", "PaidMediaPreview", "P", "previous"]], "sourcename": "", "toc": "<ul>\n<li><a class=\"reference internal\" href=\"#\">PaidMediaPhoto</a><ul>\n<li><a class=\"reference internal\" href=\"#pyrogram.types.PaidMediaPhoto\"><code class=\"docutils literal notranslate\"><span class=\"pre\">PaidMediaPhoto</span></code></a></li>\n</ul>\n</li>\n</ul>\n", "display_toc": true, "p