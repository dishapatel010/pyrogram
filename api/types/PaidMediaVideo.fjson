{"parents": [{"link": "../", "title": "Available Types"}], "prev": {"link": "../PaidMediaPhoto/", "title": "PaidMediaPhoto"}, "next": {"link": "../Contact/", "title": "Contact"}, "title": "PaidMediaVideo", "meta": null, "body": "<section id=\"paidmediavideo\">\n<h1>PaidMediaVideo<a class=\"headerlink\" href=\"#paidmediavideo\" title=\"Link to this heading\">\u00b6</a></h1>\n<dl class=\"py class\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.types.PaidMediaVideo\">\n<em class=\"property\"><span class=\"pre\">class</span><span class=\"w\"> </span></em><span class=\"sig-prename descclassname\"><span class=\"pre\">pyrogram.types.</span></span><span class=\"sig-name descname\"><span class=\"pre\">PaidMediaVideo</span></span><a class=\"headerlink\" href=\"#pyrogram.types.PaidMediaVideo\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>The paid media is a video.</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p><strong>video</strong> (<a class=\"reference internal\" href=\"../Video/#pyrogram.types.Video\" title=\"pyrogram.types.Video\"><code class=\"xref py py-obj docutils literal notranslate\"><span class=\"pre\">Video</span></code></a>) \u2013 The video.</p>\n</dd>\n</dl>\n</dd></dl>\n\n</section>\n", "metatags": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n", "rellinks": [["genindex", "General Index", "I", "index"], ["py-modindex", "Python Module Index", "", "modules"], ["api/types/Contact", "Contact", "N", "next"], ["api/types/PaidMediaPhoto", "PaidMediaPhoto", "P", "previous"]], "sourcename": "", "toc": "<ul>\n<li><a class=\"reference internal\" href=\"#\">PaidMediaVideo</a><ul>\n<li><a class=\"reference internal\" href=\"#pyrogram.types.PaidMediaVideo\"><code class=\"docutils literal notranslate\"><span class=\"pre\">PaidMediaVideo</span></code></a></li>\n</ul>\n</li>\n</ul>\n", "display_toc": true, "page_source_suffix": ".rst", "current