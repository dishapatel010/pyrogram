{"parents": [{"link": "../", "title": "Available Types"}], "prev": {"link": "../DirectMessagePriceChanged/", "title": "DirectMessagePriceChanged"}, "next": {"link": "../Dialog/", "title": "Dialog"}, "title": "PaidMessagesRefunded", "meta": null, "body": "<section id=\"paidmessagesrefunded\">\n<h1>PaidMessagesRefunded<a class=\"headerlink\" href=\"#paidmessagesrefunded\" title=\"Link to this heading\">\u00b6</a></h1>\n<dl class=\"py class\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.types.PaidMessagesRefunded\">\n<em class=\"property\"><span class=\"pre\">class</span><span class=\"w\"> </span></em><span class=\"sig-prename descclassname\"><span class=\"pre\">pyrogram.types.</span></span><span class=\"sig-name descname\"><span class=\"pre\">PaidMessagesRefunded</span></span><a class=\"headerlink\" href=\"#pyrogram.types.PaidMessagesRefunded\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Describes a service message about refunded paid messages.</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><ul class=\"simple\">\n<li><p><strong>message_count</strong> (<code class=\"docutils literal notranslate\"><span class=\"pre\">int</span></code>) \u2013 The number of refunded messages.</p></li>\n<li><p><strong>star_count</strong> (<code class=\"docutils literal notranslate\"><span class=\"pre\">int</span></code>) \u2013 The number of refunded Telegram Stars.</p></li>\n</ul>\n</dd>\n</dl>\n</dd></dl>\n\n</section>\n", "metatags": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n", "rellinks": [["genindex", "General Index", "I", "index"], ["py-modindex", "Python Module Index", "", "modules"], ["api/types/Dialog", "Dialog", "N", "next"], ["api/types/DirectMessagePriceChanged", "DirectMessagePriceChanged", "P", "previous"]], "sourcename": "", "toc": "<ul>\n<li><a class=\"reference internal\" href=\"#\">PaidMessagesRefunded</a><ul>\n<li><a class=\"reference internal\" href=\"#pyrogram.types.PaidMessagesRefunded\"><code class=\"docutils literal notranslate\"><span class=\"pre\">PaidMessagesRefunded</span></code></a></li>\n</ul>\n</li>\n</ul>\n", "display_toc": true, "page_source_suffix": ".rst", "current_page_name": "api/types/PaidMessagesRefunded", "sidebars": ["sidebar/brand.html", "sidebar/search.html", "sidebar/scroll-start.html", "sidebar/navigation.html", "sidebar/scroll-end.html"], "alabaster_version": "1.0.0", "alabaster_version_info": [1, 0, 0], "furo_version": "2025.12.19", "furo_navigation_tree": "", "furo_hide_toc": false, "furo_pygments": {"light": {"background": "#eeffcc", "foreground": "black"}, "dark": {"background": "#202020", "foreground": "#d0d0d0"}}}