{"parents": [{"link": "../", "title": "Available Types"}], "prev": {"link": "../ReactionCount/", "title": "ReactionCount"}, "next": {"link": "../ReactionTypeEmoji/", "title": "ReactionTypeEmoji"}, "title": "ReactionType", "meta": null, "body": "<section id=\"reactiontype\">\n<h1>ReactionType<a class=\"headerlink\" href=\"#reactiontype\" title=\"Link to this heading\">\u00b6</a></h1>\n<dl class=\"py class\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.types.ReactionType\">\n<em class=\"property\"><span class=\"pre\">class</span><span class=\"w\"> </span></em><span class=\"sig-prename descclassname\"><span class=\"pre\">pyrogram.types.</span></span><span class=\"sig-name descname\"><span class=\"pre\">ReactionType</span></span><a class=\"headerlink\" href=\"#pyrogram.types.ReactionType\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>This object describes the type of a reaction. Currently, it can be one of</p>\n<ul class=\"simple\">\n<li><p><a class=\"reference internal\" href=\"../ReactionTypeEmoji/#pyrogram.types.ReactionTypeEmoji\" title=\"pyrogram.types.ReactionTypeEmoji\"><code class=\"xref py py-obj docutils literal notranslate\"><span class=\"pre\">ReactionTypeEmoji</span></code></a></p></li>\n<li><p><a class=\"reference internal\" href=\"../ReactionTypeCustomEmoji/#pyrogram.types.ReactionTypeCustomEmoji\" title=\"pyrogram.types.ReactionTypeCustomEmoji\"><code class=\"xref py py-obj docutils literal notranslate\"><span class=\"pre\">ReactionTypeCustomEmoji</span></code></a></p></li>\n<li><p><a class=\"reference internal\" href=\"../ReactionTypePaid/#pyrogram.types.ReactionTypePaid\" title=\"pyrogram.types.ReactionTypePaid\"><code class=\"xref py py-obj docutils literal notranslate\"><span class=\"pre\">ReactionTypePaid</span></code></a></p></li>\n</ul>\n</dd></dl>\n\n</section>\n", "metatags": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n", "rellinks": [["genindex", "General Index", "I", "index"], ["py-modindex", "Python Module Index", "", "modules"], ["api/types/ReactionTypeEmoji", "ReactionTypeEmoji", "N", "next"], ["api/types/ReactionCount", "ReactionCount", "P", "previous"]], "sourcename": "", "toc": "<ul>\n<li><a class=\"reference internal\" href=\"#\">ReactionType</a><ul>\n<li><a class=\"reference internal\" href=\"#pyrogram.types.ReactionType\"><code class=\"docutils literal notranslate\"><span class=\"pre\">ReactionType</span></code></a></li>\n</ul>\n</li>\n</ul>\n", "display_toc": true, "page_source_suffix": ".rst", "current_page_name": "api/types/ReactionType", "sidebars": ["sidebar/brand.html", "sidebar/search.html", "sidebar/scroll-start.html", "sidebar/navigation.html", "sidebar/scroll-end.html"], "alabaster_version": "1.0.0", "alabaster_version_info": [1, 0, 0], "furo_version": "2025.12.19", "furo_navigation_tree": "", "furo_hide_toc": false, "furo_pygments": {"light": {"background": "#eeffcc", "foreground": "black"}, "dark": {"background": "#202020", "foreground": "#d0d0d0"}}}