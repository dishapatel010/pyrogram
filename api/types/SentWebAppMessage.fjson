{"parents": [{"link": "../", "title": "Available Types"}], "prev": {"link": "../MenuButtonDefault/", "title": "MenuButtonDefault"}, "next": {"link": "../SwitchInlineQueryChosenChat/", "title": "SwitchInlineQueryChosenChat"}, "title": "SentWebAppMessage", "meta": null, "body": "<section id=\"sentwebappmessage\">\n<h1>SentWebAppMessage<a class=\"headerlink\" href=\"#sentwebappmessage\" title=\"Link to this heading\">\u00b6</a></h1>\n<dl class=\"py class\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.types.SentWebAppMessage\">\n<em class=\"property\"><span class=\"pre\">class</span><span class=\"w\"> </span></em><span class=\"sig-prename descclassname\"><span class=\"pre\">pyrogram.types.</span></span><span class=\"sig-name descname\"><span class=\"pre\">SentWebAppMessage</span></span><a class=\"headerlink\" href=\"#pyrogram.types.SentWebAppMessage\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Contains information about an inline message sent by a <a class=\"reference external\" href=\"https://core.telegram.org/bots/webapps\">Web App</a> on behalf of a user.</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p><strong>inline_message_id</strong> (<code class=\"docutils literal notranslate\"><span class=\"pre\">str</span></code>) \u2013 Identifier of the sent inline message.\nAvailable only if there is an inline keyboard attached to the message.</p>\n</dd>\n</dl>\n</dd></dl>\n\n</section>\n", "metatags": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n", "rellinks": [["genindex", "General Index", "I", "index"], ["py-modindex", "Python Module Index", "", "modules"], ["api/types/SwitchInlineQueryChosenChat", "SwitchInlineQueryChosenChat", "N", "next"], ["api/types/MenuButtonDefault", "MenuButtonDefault", "P", "previous"]], "sourcename": "", "toc": "<ul>\n<li><a class=\"reference internal\" href=\"#\">SentWebAppMessage</a><ul>\n<li><a class=\"reference internal\" href=\"#pyrogram.types.SentWebAppMessage\"><code class=\"docutils literal notranslate\"><span class=\"pre\">SentWebAppMessage</span></code></a></li>\n</ul>\n</li>\n</ul>\n", "display_toc": true, "page_source_suffix": ".rst", "current_page_name": "api/types/SentWebAppMessage", "sidebars": ["sidebar/brand.html", "sidebar/search.html", "sidebar/scroll-start.html", "sidebar/navigation.html", "sidebar/scroll-end.html"], "alabaster_version": "1.0.0", "alabaster_version_info": [1, 0, 0], "furo_version": "2025.12.19", "furo_navigation_tree": "", "furo_hide_toc": false, "furo_pygments": {"light": {"background": "#eeffcc", "foreground": "black"}, "dark": {"background": "#202020", "foreground": "#d0d0d0"}}}