{"parents": [{"link": "../", "title": "Available Types"}], "prev": {"link": "../RefundedPayment/", "title": "RefundedPayment"}, "next": {"link": "../PreCheckoutQuery/", "title": "PreCheckoutQuery"}, "title": "ShippingQuery", "meta": null, "body": "<section id=\"shippingquery\">\n<h1>ShippingQuery<a class=\"headerlink\" href=\"#shippingquery\" title=\"Link to this heading\">\u00b6</a></h1>\n<dl class=\"py class\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.types.ShippingQuery\">\n<em class=\"property\"><span class=\"pre\">class</span><span class=\"w\"> </span></em><span class=\"sig-prename descclassname\"><span class=\"pre\">pyrogram.types.</span></span><span class=\"sig-name descname\"><span class=\"pre\">ShippingQuery</span></span><a class=\"headerlink\" href=\"#pyrogram.types.ShippingQuery\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>This object contains information about an incoming shipping query.</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><ul class=\"simple\">\n<li><p><strong>id</strong> (<code class=\"docutils literal notranslate\"><span class=\"pre\">str</span></code>) \u2013 Unique query identifier.</p></li>\n<li><p><strong>from_user</strong> (<a class=\"reference internal\" href=\"../User/#pyrogram.types.User\" title=\"pyrogram.types.User\"><code class=\"xref py py-obj docutils literal notranslate\"><span class=\"pre\">User</span></code></a>) \u2013 User who sent the query.</p></li>\n<li><p><strong>invoice_payload</strong> (<code class=\"docutils literal notranslate\"><span class=\"pre\">str</span></code>) \u2013 Bot specified invoice payload. Only available to the bot that received the payment.</p></li>\n<li><p><strong>shipping_address</strong> (<a class=\"reference internal\" href=\"../ShippingAddress/#pyrogram.types.ShippingAddress\" title=\"pyrogram.types.ShippingAddress\"><code class=\"xref py py-obj docutils literal notranslate\"><span class=\"pre\">ShippingAddress</span></code></a>) \u2013 User specified shipping address. Only available to the bot that received the payment.</p></li>\n</ul>\n</dd>\n</dl>\n</dd></dl>\n\n</section>\n", "metatags": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n", "rellinks": [["genindex", "General Index", "I", "index"], ["py-modindex", "Python Module Index", "", "modules"], ["api/types/PreCheckoutQuery", "PreCheckoutQuery", "N", "next"], ["api/types/RefundedPayment", "RefundedPayment", "P", "previous"]], "sourcename": "", "toc": "<ul>\n<li><a class=\"reference internal\" href=\"#\">ShippingQuery</a><ul>\n<li><a class=\"reference internal\" href=\"#pyrogram.types.ShippingQuery\"><code class=\"docutils literal notranslate\"><span class=\"pre\">ShippingQuery</span></code></a></li>\n</ul>\n</li>\n</ul>\n", "display_toc": true, "page_source_suffix": ".rst", "current_page_name": "api/types/ShippingQuery", "sidebars": ["sidebar/brand.html", "sidebar/search.html", "sidebar/scroll-start.html", "sidebar/navigation.html", "sidebar/scroll-end.html"], "alabaster_version": "1.0.0", "alabaster_version_info": [1, 0, 0], "furo_version": "2025.12.19", "furo_navigation_tree": "", "furo_hide_toc": false, "furo_pygments": {"light": {"background": "#eeffcc", "foreground": "black"}, "dark": {"background": "#202020", "foreground": "#d0d0d0"}}}