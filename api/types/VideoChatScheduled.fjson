{"parents": [{"link": "../", "title": "Available Types"}], "prev": {"link": "../ChatReactions/", "title": "ChatReactions"}, "next": {"link": "../VideoChatStarted/", "title": "VideoChatStarted"}, "title": "VideoChatScheduled", "meta": null, "body": "<section id=\"videochatscheduled\">\n<h1>VideoChatScheduled<a class=\"headerlink\" href=\"#videochatscheduled\" title=\"Link to this heading\">\u00b6</a></h1>\n<dl class=\"py class\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.types.VideoChatScheduled\">\n<em class=\"property\"><span class=\"pre\">class</span><span class=\"w\"> </span></em><span class=\"sig-prename descclassname\"><span class=\"pre\">pyrogram.types.</span></span><span class=\"sig-name descname\"><span class=\"pre\">VideoChatScheduled</span></span><a class=\"headerlink\" href=\"#pyrogram.types.VideoChatScheduled\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>A service message about a voice chat scheduled in the chat.</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p><strong>start_date</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3/library/datetime.html#datetime.datetime\" title=\"(in Python v3.14)\"><code class=\"xref py py-obj docutils literal notranslate\"><span class=\"pre\">datetime</span></code></a>) \u2013 Point in time when the voice chat is expected to be started by a chat administrator.</p>\n</dd>\n</dl>\n</dd></dl>\n\n</section>\n", "metatags": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n", "rellinks": [["genindex", "General Index", "I", "index"], ["py-modindex", "Python Module Index", "", "modules"], ["api/types/VideoChatStarted", "VideoChatStarted", "N", "next"], ["api/types/ChatReactions", "ChatReactions", "P", "previous"]], "sourcename": "", "toc": "<ul>\n<li><a class=\"reference internal\" href=\"#\">VideoChatScheduled</a><ul>\n<li><a class=\"reference internal\" href=\"#pyrogram.types.VideoChatScheduled\"><code class=\"docutils literal notranslate\"><span class=\"pre\">VideoChatScheduled</span></code></a></li>\n</ul>\n</li>\n</ul>\n", "display_toc": true, "page_source_suffix": ".rst", "current_page_name": "api/types/VideoChatScheduled", "sidebars": ["sidebar/brand.html", "sidebar/search.html", "sidebar/scroll-start.html", "sidebar/navigation.html", "sidebar/scroll-end.html"], "alabaster_version": "1.0.0", "alabaster_version_info": [1, 0, 0], "furo_version": "2025.12.19", "furo_navigation_tree": "", "furo_hide_toc": false, "furo_pygments": {"light": {"background": "#eeffcc", "foreground": "black"}, "dark": {"background": "#202020", "foreground": "#d0d0d0"}}}