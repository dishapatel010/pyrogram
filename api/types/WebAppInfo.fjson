{"parents": [{"link": "../", "title": "Available Types"}], "prev": {"link": "../LoginUrl/", "title": "LoginUrl"}, "next": {"link": "../MenuButton/", "title": "MenuButton"}, "title": "WebAppInfo", "meta": null, "body": "<section id=\"webappinfo\">\n<h1>WebAppInfo<a class=\"headerlink\" href=\"#webappinfo\" title=\"Link to this heading\">\u00b6</a></h1>\n<dl class=\"py class\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.types.WebAppInfo\">\n<em class=\"property\"><span class=\"pre\">class</span><span class=\"w\"> </span></em><span class=\"sig-prename descclassname\"><span class=\"pre\">pyrogram.types.</span></span><span class=\"sig-name descname\"><span class=\"pre\">WebAppInfo</span></span><a class=\"headerlink\" href=\"#pyrogram.types.WebAppInfo\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Contains information about a <a class=\"reference external\" href=\"https://core.telegram.org/bots/webapps\">Web App</a>.</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p><strong>url</strong> (<code class=\"docutils literal notranslate\"><span class=\"pre\">str</span></code>) \u2013 An HTTPS URL of a Web App to be opened with additional data as specified in\n<a class=\"reference external\" href=\"https://core.telegram.org/bots/webapps#initializing-web-apps\">Initializing Web Apps</a>.</p>\n</dd>\n</dl>\n</dd></dl>\n\n</section>\n", "metatags": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n", "rellinks": [["genindex", "General Index", "I", "index"], ["py-modindex", "Python Module Index", "", "modules"], ["api/types/MenuButton", "MenuButton", "N", "next"], ["api/types/LoginUrl", "LoginUrl", "P", "previous"]], "sourcename": "", "toc": "<ul>\n<li><a class=\"reference internal\" href=\"#\">WebAppInfo</a><ul>\n<li><a class=\"reference internal\" href=\"#pyrogram.types.WebAppInfo\"><code class=\"docutils literal notranslate\"><span class=\"pre\">WebAppInfo</span></code></a></li>\n</ul>\n</li>\n</ul>\n", "display_toc": true, "page_source_suffix": ".rst", "current_page_name": "api/types/WebAppInfo", "sidebars": ["sidebar/brand.html", "sidebar/search.html", "sidebar/scroll-start.html", "sidebar/navigation.html", "sidebar/scroll-end.html"], "alabaster_version": "1.0.0", "alabaster_version_info": [1, 0, 0], "furo_version": "2025.12.19", "furo_navigation_tree": "", "furo_hide_toc": false, "furo_pygments": {"light": {"background": "#eeffcc", "foreground": "black"}, "dark": {"background": "#202020", "foreground": "#d0d0d0"}}}