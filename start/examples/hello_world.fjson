{"parents": [{"link": "../", "title": "Examples"}], "prev": {"link": "../", "title": "Examples"}, "next": {"link": "../echo_bot/", "title": "echo_bot"}, "title": "hello_world", "meta": null, "body": "<section id=\"hello-world\">\n<h1>hello_world<a class=\"headerlink\" href=\"#hello-world\" title=\"Link to this heading\">\u00b6</a></h1>\n<p>This example demonstrates a basic API usage</p>\n<strong>Usable by</strong>\n<span class=\"usable-by\"><i class=\"fa-solid fa-check\" style=\"color: var(--color-green)\"></i> Users</span>\n<span class=\"usable-by\"><i class=\"fa-solid fa-xmark\" style=\"color: var(--color-red)\"></i> Bots</span><div class=\"highlight-python notranslate\"><div class=\"highlight\"><pre><span></span><span class=\"kn\">from</span><span class=\"w\"> </span><span class=\"nn\">pyrogram</span><span class=\"w\"> </span><span class=\"kn\">import</span> <span class=\"n\">Client</span>\n\n<span class=\"c1\"># Create a new Client instance</span>\n<span class=\"n\">app</span> <span class=\"o\">=</span> <span class=\"n\">Client</span><span class=\"p\">(</span><span class=\"s2\">&quot;my_account&quot;</span><span class=\"p\">)</span>\n\n\n<span class=\"k\">async</span> <span class=\"k\">def</span><span class=\"w\"> </span><span class=\"nf\">main</span><span class=\"p\">():</span>\n    <span class=\"k\">async</span> <span class=\"k\">with</span> <span class=\"n\">app</span><span class=\"p\">:</span>\n        <span class=\"c1\"># Send a message, Markdown is enabled by default</span>\n        <span class=\"k\">await</span> <span class=\"n\">app</span><span class=\"o\">.</span><span class=\"n\">send_message</span><span class=\"p\">(</span><span class=\"n\">chat_id</span><span class=\"o\">=</span><span class=\"s2\">&quot;me&quot;</span><span class=\"p\">,</span> <span class=\"n\">text</span><span class=\"o\">=</span><span class=\"s2\">&quot;Hi there! I&#39;m using **Pyrogram**&quot;</span><span class=\"p\">)</span>\n\n\n<span class=\"n\">app</span><span class=\"o\">.</span><span class=\"n\">run</span><span class=\"p\">(</span><span class=\"n\">main</span><span class=\"p\">())</span>\n</pre></div>\n</div>\n</section>\n", "metatags": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n", "rellinks": [["genindex", "General Index", "I", "index"], ["py-modindex", "Python Module Index", "", "modules"], ["start/examples/echo_bot", "echo_bot", "N", "next"], ["start/examples/index", "Examples", "P", "previous"]], "sourcename": "", "toc": "<ul>\n<li><a class=\"reference internal\" href=\"#\">hello_world</a></li>\n</ul>\n", "display_toc": false, "page_source_suffix": ".rst", "current_page_name": "start/examples/hello_world", "sidebars": ["sidebar/brand.html", "sidebar/search.html", "sidebar/scroll-start.html", "sidebar/navigation.html", "sidebar/scroll-end.html"], "alabaster_version": "1.0.0", "alabaster_version_info": [1, 0, 0], "furo_version": "2025.12.19", "furo_navigation_tree": "", "furo_hide_toc": true, "furo_pygments": {"light": {"background": "#eeffcc", "foreground": "black"}, "dark": {"background": "#202020", "foreground": "#d0d0d0"}}}