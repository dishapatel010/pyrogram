{"parents": [{"link": "../", "title": "Raw Base"}], "prev": {"link": "../encrypted-chat/", "title": "EncryptedChat"}, "next": {"link": "../encrypted-message/", "title": "EncryptedMessage"}, "title": "EncryptedFile", "meta": null, "body": "<section id=\"encryptedfile\">\n<h1>EncryptedFile<a class=\"headerlink\" href=\"#encryptedfile\" title=\"Link to this heading\">\u00b6</a></h1>\n<dl class=\"py class\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.raw.base.EncryptedFile\">\n<em class=\"property\"><span class=\"pre\">class</span><span class=\"w\"> </span></em><span class=\"sig-prename descclassname\"><span class=\"pre\">pyrogram.raw.base.</span></span><span class=\"sig-name descname\"><span class=\"pre\">EncryptedFile</span></span><a class=\"headerlink\" href=\"#pyrogram.raw.base.EncryptedFile\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Telegram API base type.</p>\n<dl>\n<dt>Constructors:</dt><dd><p>This base type has 2 constructors available.</p>\n<div class=\"table-wrapper autosummary longtable docutils container\">\n<table class=\"autosummary longtable docutils align-default\">\n<tbody>\n<tr class=\"row-odd\"><td><p><a class=\"reference internal\" href=\"../../types/encrypted-file/#pyrogram.raw.types.EncryptedFile\" title=\"pyrogram.raw.types.EncryptedFile\"><code class=\"xref py py-obj docutils literal notranslate\"><span class=\"pre\">EncryptedFile</span></code></a></p></td>\n<td><p>Telegram API type.</p></td>\n</tr>\n<tr class=\"row-even\"><td><p><a class=\"reference internal\" href=\"../../types/encrypted-file-empty/#pyrogram.raw.types.EncryptedFileEmpty\" title=\"pyrogram.raw.types.EncryptedFileEmpty\"><code class=\"xref py py-obj docutils literal notranslate\"><span class=\"pre\">EncryptedFileEmpty</span></code></a></p></td>\n<td><p>Telegram API type.</p></td>\n</tr>\n</tbody>\n</table>\n</div>\n</dd>\n<dt>Functions:</dt><dd><p>This object can be returned by 1 function.</p>\n<div class=\"table-wrapper autosummary longtable docutils container\">\n<table class=\"autosummary longtable docutils align-default\">\n<tbody>\n<tr class=\"row-odd\"><td><p><a class=\"reference internal\" href=\"../../functions/messages/upload-encrypted-file/#pyrogram.raw.functions.messages.UploadEncryptedFile\" title=\"pyrogram.raw.functions.messages.UploadEncryptedFile\"><code class=\"xref py py-obj docutils literal notranslate\"><span class=\"pre\">messages.UploadEncryptedFile</span></code></a></p></td>\n<td><p>Telegram API function.</p></td>\n</tr>\n</tbody>\n</table>\n</div>\n</dd>\n</dl>\n</dd></dl>\n\n</section>\n", "metatags": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n", "rellinks": [["genindex", "General Index", "I", "index"], ["py-modindex", "Python Module Index", "", "modules"], ["telegram/base/encrypted-message", "EncryptedMessage", "N", "next"], ["telegram/base/encrypted-chat", "EncryptedChat", "P", "previous"]], "sourcename": "", "toc": "<ul>\n<li><a class=\"reference internal\" href=\"#\">EncryptedFile</a><ul>\n<li><a class=\"reference internal\" href=\"#pyrogram.raw.base.EncryptedFile\"><code class=\"docutils literal notranslate\"><span class=\"pre\">EncryptedFile</span></code></a></li>\n</ul>\n</li>\n</ul>\n", "display_toc": true, "page_source_suffix": ".rst", "current_page_name": "telegram/base/encrypted-file", "sidebars": ["sidebar/brand.html", "sidebar/search.html", "sidebar/scroll-start.html", "sidebar/navigation.html", "sidebar/scroll-end.html"], "alabaster_version": "1.0.0", "alabaster_version_info": [1, 0, 0], "furo_version": "2025.12.19", "furo_navigation_tree": "", "furo_hide_toc": false, "furo_pygments": {"light": {"background": "#eeffcc", "foreground": "black"}, "dark": {"background": "#202020", "foreground": "#d0d0d0"}}}