{"parents": [{"link": "../../", "title": "Raw Base"}, {"link": "../", "title": "Help"}], "prev": {"link": "../app-config/", "title": "help.AppConfig"}, "next": {"link": "../config-simple/", "title": "help.ConfigSimple"}, "title": "help.AppUpdate", "meta": null, "body": "<section id=\"help-appupdate\">\n<h1>help.AppUpdate<a class=\"headerlink\" href=\"#help-appupdate\" title=\"Link to this heading\">\u00b6</a></h1>\n<dl class=\"py class\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.raw.base.help.AppUpdate\">\n<em class=\"property\"><span class=\"pre\">class</span><span class=\"w\"> </span></em><span class=\"sig-prename descclassname\"><span class=\"pre\">pyrogram.raw.base.help.</span></span><span class=\"sig-name descname\"><span class=\"pre\">AppUpdate</span></span><a class=\"headerlink\" href=\"#pyrogram.raw.base.help.AppUpdate\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Telegram API base type.</p>\n<dl>\n<dt>Constructors:</dt><dd><p>This base type has 2 constructors available.</p>\n<div class=\"table-wrapper autosummary longtable docutils container\">\n<table class=\"autosummary longtable docutils align-default\">\n<tbody>\n<tr class=\"row-odd\"><td><p><a class=\"reference internal\" href=\"../../../types/help/app-update/#pyrogram.raw.types.help.AppUpdate\" title=\"pyrogram.raw.types.help.AppUpdate\"><code class=\"xref py py-obj docutils literal notranslate\"><span class=\"pre\">help.AppUpdate</span></code></a></p></td>\n<td><p>Telegram API type.</p></td>\n</tr>\n<tr class=\"row-even\"><td><p><a class=\"reference internal\" href=\"../../../types/help/no-app-update/#pyrogram.raw.types.help.NoAppUpdate\" title=\"pyrogram.raw.types.help.NoAppUpdate\"><code class=\"xref py py-obj docutils literal notranslate\"><span class=\"pre\">help.NoAppUpdate</span></code></a></p></td>\n<td><p>Telegram API type.</p></td>\n</tr>\n</tbody>\n</table>\n</div>\n</dd>\n<dt>Functions:</dt><dd><p>This object can be returned by 1 function.</p>\n<div class=\"table-wrapper autosummary longtable docutils container\">\n<table class=\"autosummary longtable docutils align-default\">\n<tbody>\n<tr class=\"row-odd\"><td><p><a class=\"reference internal\" href=\"../../../functions/help/get-app-update/#pyrogram.raw.functions.help.GetAppUpdate\" title=\"pyrogram.raw.functions.help.GetAppUpdate\"><code class=\"xref py py-obj docutils literal notranslate\"><span class=\"pre\">help.GetAppUpdate</span></code></a></p></td>\n<td><p>Telegram API function.</p></td>\n</tr>\n</tbody>\n</table>\n</div>\n</dd>\n</dl>\n</dd></dl>\n\n</section>\n", "metatags": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n", "rellinks": [["genindex", "General Index", "I", "index"], ["py-modindex", "Python Module Index", "", "modules"], ["telegram/base/help/config-simple", "help.ConfigSimple", "N", "next"], ["telegram/base/help/app-config", "help.AppConfig", "P", "previous"]], "sourcename": "", "toc": "<ul>\n<li><a class=\"reference internal\" href=\"#\">help.AppUpdate</a><ul>\n<li><a class=\"reference internal\" href=\"#pyrogram.raw.base.help.AppUpdate\"><code class=\"docutils literal notranslate\"><span class=\"pre\">AppUpdate</span></code></a></li>\n</ul>\n</li>\n</ul>\n", "display_toc": true, "page_source_suffix": ".rst", "current_page_name": "telegram/base/help/app-update", "sidebars": ["sidebar/brand.html", "sidebar/search.html", "sidebar/scroll-start.html", "sidebar/navigation.html", "sidebar/scroll-end.html"], "alabaster_version": "1.0.0", "alabaster_version_info": [1, 0, 0], "furo_version": "2025.12.19", "furo_navigation_tree": "", "furo_hide_toc": false, "furo_pygments": {"light": {"background": "#eeffcc", "foreground": "black"}, "dark": {"background": "#202020", "foreground": "#d0d0d0"}}}