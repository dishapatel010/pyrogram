{"parents": [{"link": "../", "title": "Raw Base"}], "prev": {"link": "../fragment/collectible-info/", "title": "fragment.CollectibleInfo"}, "next": {"link": "app-config/", "title": "help.AppConfig"}, "title": "Help", "meta": null, "body": "<section id=\"module-pyrogram.raw.base.help\">\n<span id=\"help\"></span><h1>Help<a class=\"headerlink\" href=\"#module-pyrogram.raw.base.help\" title=\"Link to this heading\">\u00b6</a></h1>\n<div class=\"toctree-wrapper compound\">\n<ul>\n<li class=\"toctree-l1\"><a class=\"reference internal\" href=\"app-config/\">AppConfig</a></li>\n<li class=\"toctree-l1\"><a class=\"reference internal\" href=\"app-update/\">AppUpdate</a></li>\n<li class=\"toctree-l1\"><a class=\"reference internal\" href=\"config-simple/\">ConfigSimple</a></li>\n<li class=\"toctree-l1\"><a class=\"reference internal\" href=\"countries-list/\">CountriesList</a></li>\n<li class=\"toctree-l1\"><a class=\"reference internal\" href=\"country/\">Country</a></li>\n<li class=\"toctree-l1\"><a class=\"reference internal\" href=\"country-code/\">CountryCode</a></li>\n<li class=\"toctree-l1\"><a class=\"reference internal\" href=\"deep-link-info/\">DeepLinkInfo</a></li>\n<li class=\"toctree-l1\"><a class=\"reference internal\" href=\"invite-text/\">InviteText</a></li>\n<li class=\"toctree-l1\"><a class=\"reference internal\" href=\"passport-config/\">PassportConfig</a></li>\n<li class=\"toctree-l1\"><a class=\"reference internal\" href=\"peer-color-option/\">PeerColorOption</a></li>\n<li class=\"toctree-l1\"><a class=\"reference internal\" href=\"peer-color-set/\">PeerColorSet</a></li>\n<li class=\"toctree-l1\"><a class=\"reference internal\" href=\"peer-colors/\">PeerColors</a></li>\n<li class=\"toctree-l1\"><a class=\"reference internal\" href=\"premium-promo/\">PremiumPromo</a></li>\n<li class=\"toctree-l1\"><a class=\"reference internal\" href=\"promo-data/\">PromoData</a></li>\n<li class=\"toctree-l1\"><a class=\"reference internal\" href=\"recent-me-urls/\">Recen