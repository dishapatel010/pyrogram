td><p>Telegram API type.</p></td>\n</tr>\n</tbody>\n</table>\n</div>\n</dd>\n<dt>Functions:</dt><dd><p>This object can be returned by 1 function.</p>\n<div class=\"table-wrapper autosummary longtable docutils container\">\n<table class=\"autosummary longtable docutils align-default\">\n<tbody>\n<tr class=\"row-odd\"><td><p><a class=\"reference internal\" href=\"../../functions/chatlists/get-leave-chatlist-suggestions/#pyrogram.raw.functions.chatlists.GetLeaveChatlistSuggestions\" title=\"pyrogram.raw.functions.chatlists.GetLeaveChatlistSuggestions\"><code class=\"xref py py-obj docutils literal notranslate\"><span class=\"pre\">chatlists.GetLeaveChatlistSuggestions</span></code></a></p></td>\n<td><p>Telegram API function.</p></td>\n</tr>\n</tbody>\n</table>\n</div>\n</dd>\n</dl>\n</dd></dl>\n\n</section>\n", "metatags": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n", "rellinks": [["genindex", "General Index", "I", "index"], ["py-modindex", "Python Module Index", "", "modules"], ["telegram/base/peer-blocked", "PeerBlocked", "N", "next"], ["telegram/base/payment-saved-credentials", "PaymentSavedCredentials", "P", "previous"]], "sourcename": "", "toc": "<ul>\n<li><a class=\"reference internal\" href=\"#\">Peer</a><ul>\n<li><a class=\"reference internal\" href=\"#pyrogram.raw.base.Peer\"><code class=\"docutils literal notranslate\"><span class=\"pre\">Peer</span></code></a></li>\n</ul>\n</li>\n</ul>\n", "display_toc": true, "page_source_suffix": ".rst", "current_page_name": "telegram/base/peer", "sidebars": ["sidebar/brand.html", "sidebar/search.html", "sidebar/scroll-start.html", "sidebar/navigation.html", "sidebar/scroll-end.html"], "alabaster_version": "1.0.0", "alabaster_version_info": [1, 0, 0], "furo_version": "2025.12.19", "furo_navigation_tree": "", "furo_hide_toc": false, "furo_pygments": {"light": {"background": "#eeffcc", "foreground": "black"}, "dark": {"background": "#202020", "foreground": "#d0d0d0"}}}