{"parents": [{"link": "../", "title": "Raw Base"}], "prev": {"link": "../updates/", "title": "Updates"}, "next": {"link": "../user/", "title": "User"}, "title": "UrlAuthResult", "meta": {}, "body": "<section id=\"urlauthresult\">\n<h1>UrlAuthResult<a class=\"headerlink\" href=\"#urlauthresult\" title=\"Link to this heading\">\u00b6</a></h1>\n<dl class=\"py class\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.raw.base.UrlAuthResult\">\n<em class=\"property\"><span class=\"pre\">class</span><span class=\"w\"> </span></em><span class=\"sig-prename descclassname\"><span class=\"pre\">pyrogram.raw.base.</span></span><span class=\"sig-name descname\"><span class=\"pre\">UrlAuthResult</span></span><a class=\"headerlink\" href=\"#pyrogram.raw.base.UrlAuthResult\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Telegram API base type.</p>\n<dl>\n<dt>Constructors:</dt><dd><p>This base type has 3 constructors available.</p>\n<div class=\"table-wrapper autosummary longtable docutils container\">\n<table class=\"autosummary longtable docutils align-default\">\n<tbody>\n<tr class=\"row-odd\"><td><p><a class=\"reference internal\" href=\"../../types/url-auth-result-accepted/#pyrogram.raw.types.UrlAuthResultAccepted\" title=\"pyrogram.raw.types.UrlAuthResultAccepted\"><code class=\"xref py py-obj docutils literal notranslate\"><span class=\"pre\">UrlAuthResultAccepted</span></code></a></p></td>\n<td><p>Telegram API type.</p></td>\n</tr>\n<tr class=\"row-even\"><td><p><a class=\"reference internal\" href=\"../../types/url-auth-result-default/#pyrogram.raw.types.UrlAuthResultDefault\" title=\"pyrogram.raw.types.UrlAuthResultDefault\"><code class=\"xref py py-obj docutils literal notranslate\"><span class=\"pre\">UrlAuthResultDefault</span></code></a></p></td>\n<td><p>Telegram API type.</p></td>\n</tr>\n<tr class=\"row-odd\"><td><p><a class=\"reference internal\" href=\"../../types/url-auth-result-request/#pyrogram.raw.types.UrlAuthResultRequest\" title=\"pyrogram.raw.types.UrlAuthResultRequest\"><code class=\"xref py py-obj docutils literal notranslate\"><span class=\"pre\">UrlAuthResultRequest</span></code></a></p></td>\n<td><p>Telegram API type.</p></td>\n</tr>\n</tbody>\n</table>\n</div>\n</dd>\n<dt>Functions:</dt><dd><p>This object can be returned by 2 functions.</p>\n<div class=\"table-wrapper autosummary longtable docutils container\">\n<table class=\"autosummary longtable docutils align-default\">\n<tbody>\n<tr class=\"row-odd\"><td><p><a class=\"reference internal\" href=\"../../functions/messages/request-url-auth/#pyrogram.raw.functions.messages.RequestUrlAuth\" title=\"pyrogram.raw.functions.messages.RequestUrlAuth\"><code class=\"xref py py-obj docutils literal notranslate\"><span class=\"pre\">messages.RequestUrlAuth</span></code></a></p></td>\n<td><p>Telegram API function.</p></td>\n</tr>\n<tr class=\"row-even\"><td><p><a class=\"reference internal\" href=\"../../functions/messages/accept-url-auth/#pyrogram.raw.functions.messages.AcceptUrlAuth\" title=\"pyrogram.raw.functions.messages.AcceptUrlAuth\"><code class=\"xref py py-obj docutils literal notranslate\"><span class=\"pre\">messages.AcceptUrlAuth</span></code></a></p></td>\n<td><p>Telegram API function.</p></td>\n</tr>\n</tbody>\n</table>\n</div>\n</dd>\n</dl>\n</dd></dl>\n\n</section>\n", "metatags": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n", "rellinks": [["genindex", "General Index", "I", "index"], ["py-modindex", "Python Module Index", "", "modules"], ["telegram/base/user", "User", "N", "next"], ["telegram/base/updates", "Updates", "P", "previous"]], "sourcename": "", "toc": "<ul>\n<li><a class=\"reference internal\" href=\"#\">UrlAuthResult</a><ul>\n<li><a class=\"reference internal\" href=\"#pyrogram.raw.base.UrlAuthResult\"><code class=\"docutils literal notranslate\"><span class=\"pre\">UrlAuthResult</span></code></a></li>\n</ul>\n</li>\n</ul>\n", "display_toc": true, "page_source_suffix": ".rst", "current_page_name": "t