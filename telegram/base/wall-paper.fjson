{"parents": [{"link": "../", "title": "Raw Base"}], "prev": {"link": "../video-size/", "title": "VideoSize"}, "next": {"link": "../wall-paper-settings/", "title": "WallPaperSettings"}, "title": "WallPaper", "meta": {}, "body": "<section id=\"wallpaper\">\n<h1>WallPaper<a class=\"headerlink\" href=\"#wallpaper\" title=\"Link to this heading\">\u00b6</a></h1>\n<dl class=\"py class\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.raw.base.WallPaper\">\n<em class=\"property\"><span class=\"pre\">class</span><span class=\"w\"> </span></em><span class=\"sig-prename descclassname\"><span class=\"pre\">pyrogram.raw.base.</span></span><span class=\"sig-name descname\"><span class=\"pre\">WallPaper</span></span><a class=\"headerlink\" href=\"#pyrogram.raw.base.WallPaper\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Telegram API base type.</p>\n<dl>\n<dt>Constructors:</dt><dd><p>This base type has 2 constructors available.</p>\n<div class=\"table-wrapper autosummary longtable docutils container\">\n<table class=\"autosummary longtable docutils align-default\">\n<tbody>\n<tr class=\"row-odd\"><td><p><a class=\"reference internal\" href=\"../../types/wall-paper/#pyrogram.raw.types.WallPaper\" title=\"pyrogram.raw.types.WallPaper\"><code class=\"xref py py-obj docutils literal notranslate\"><span class=\"pre\">WallPaper</span></code></a></p></td>\n<td><p>Telegram API type.</p></td>\n</tr>\n<tr class=\"row-even\"><td><p><a class=\"reference internal\" href=\"../../types/wall-paper-no-file/#pyrogram.raw.types.WallPaperNoFile\" title=\"pyrogram.raw.types.WallPaperNoFile\"><code class=\"xref py py-obj docutils literal notranslate\"><span class=\"pre\">WallPaperNoFile</span></code></a></p></td>\n<td><p>Telegram API type.</p></td>\n</tr>\n</tbody>\n</table>\n</div>\n</dd>\n<dt>Functions:</dt><dd><p>This object can be returned by 3 functions.</p>\n<div class=\"table-wrapper autosummary longtable docutils container\">\n<table class=\"autosummary longtable docutils align-default\">\n<tbody>\n<tr class=\"row-odd\"><td><p><a class=\"reference internal\" href=\"../../functions/account/get-wall-paper/#pyrogram.raw.functions.account.GetWallPaper\" title=\"pyrogram.raw.functions.account.GetWallPaper\"><code class=\"xref py py-obj docutils literal notranslate\"><span class=\"pre\">account.GetWallPaper</span></code></a></p></td>\n<td><p>Telegram API function.</p></td>\n</tr>\n<tr class=\"row-even\"><td><p><a class=\"reference internal\" href=\"../../functions/account/upload-wall-paper/#pyrogram.raw.functions.account.UploadWallPaper\" title=\"pyrogram.raw.functions.account.UploadWallPaper\"><code class=\"xref py py-obj docutils literal notranslate\"><span class=\"pre\">account.UploadWallPaper</span></code></a></p></td>\n<td><p>Telegram API function.</p></td>\n</tr>\n<tr class=\"row-odd\"><td><p><a class=\"reference internal\" href=\"../../functions/account/get-multi-wall-papers/#pyrogram.raw.functions.account.GetMultiWallPapers\" title=\"pyrogram.raw.functions.account.GetMultiWallPapers\"><code class=\"xref py py-obj docutils literal notranslate\"><span class=\"pre\">account.GetMultiWallPapers</span></code></a></p></td>\n<td><p>Telegram API function.</p></td>\n</tr>\n</tbody>\n</table>\n</div>\n</dd>\n</dl>\n</dd></dl>\n\n</section>\n", "metatags": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n", "rellinks": [["genindex", "General Index", "I", "index"], ["py-modindex", "Python Module Index", "", "modules"], ["telegram/base/wall-paper-settings", "WallPaperSettings", "N", "next"], ["telegram/base/video-size", "VideoSize", "P", "previous"]], "sourcename": "", "toc": "<ul>\n<li><a class=\"reference internal\" href=\"#\">WallPaper</a><ul>\n<li><a class=\"reference internal\" href=\"#pyrogram.raw.base.WallPaper\"><code class=\"docutils literal notranslate\"><span class=\"pre\">WallPaper</span></code></a></li>\n</ul>\n</li>\n</ul>\n", "display_toc": true, "page_source_suffix": ".rst", "current_page_name": "telegram/base