{"parents": [{"link": "../", "title": "Raw Functions"}], "prev": {"link": "../account/verify-phone/", "title": "account.VerifyPhone"}, "next": {"link": "accept-login-token/", "title": "auth.AcceptLoginToken"}, "title": "Auth", "meta": null, "body": "<section id=\"module-pyrogram.raw.functions.auth\">\n<span id=\"auth\"></span><h1>Auth<a class=\"headerlink\" href=\"#module-pyrogram.raw.functions.auth\" title=\"Link to this heading\">\u00b6</a></h1>\n<div class=\"toctree-wrapper compound\">\n<ul>\n<li class=\"toctree-l1\"><a class=\"reference internal\" href=\"accept-login-token/\">AcceptLoginToken</a></li>\n<li class=\"toctree-l1\"><a class=\"reference internal\" href=\"bind-temp-auth-key/\">BindTempAuthKey</a></li>\n<li class=\"toctree-l1\"><a class=\"reference internal\" href=\"cancel-code/\">CancelCode</a></li>\n<li class=\"toctree-l1\"><a class=\"reference internal\" href=\"check-paid-auth/\">CheckPaidAuth</a></li>\n<li class=\"toctree-l1\"><a class=\"reference internal\" href=\"check-password/\">CheckPassword</a></li>\n<li class=\"toctree-l1\"><a class=\"reference internal\" href=\"check-recovery-password/\">CheckRecoveryPassword</a></li>\n<li class=\"toctree-l1\"><a class=\"reference internal\" href=\"drop-temp-auth-keys/\">DropTempAuthKeys</a></li>\n<li class=\"toctree-l1\"><a class=\"reference internal\" href=\"export-authorization/\">ExportAuthorization</a></li>\n<li class=\"toctree-l1\"><a class=\"reference internal\" href=\"export-login-token/\">ExportLoginToken</a></li>\n<li class=\"toctree-l1\"><a class=\"reference internal\" href=\"finish-passkey-login/\">FinishPasskeyLogin</a></li>\n<li class=\"toctree-l1\"><a class=\"reference internal\" href=\"import-authorization/\">ImportAuthorization</a></li>\n<li class=\"toctree-l1\"><a class=\"reference internal\" href=\"import-bot-authorization/\">ImportBotAuthorization</a></li>\n<li class=\"toctree-l1\"><a class=\"reference internal\" href=\"import-login-token/\">ImportLoginToken</a></li>\n<li class=\"toctree-