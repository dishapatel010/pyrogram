se.InputChannel\"><code class=\"xref py py-obj docutils literal notranslate\"><span class=\"pre\">InputChannel</span></code></a>, <em>optional</em>) \u2013 N/A</p></li>\n<li><p><strong>admin_rights</strong> (<a class=\"reference internal\" href=\"../../base/chat-admin-rights/#pyrogram.raw.base.ChatAdminRights\" title=\"pyrogram.raw.base.ChatAdminRights\"><code class=\"xref py py-obj docutils literal notranslate\"><span class=\"pre\">ChatAdminRights</span></code></a>, <em>optional</em>) \u2013 N/A</p></li>\n<li><p><strong>default_banned_rights</strong> (<a class=\"reference internal\" href=\"../../base/chat-banned-rights/#pyrogram.raw.base.ChatBannedRights\" title=\"pyrogram.raw.base.ChatBannedRights\"><code class=\"xref py py-obj docutils literal notranslate\"><span class=\"pre\">ChatBannedRights</span></code></a>, <em>optional</em>) \u2013 N/A</p></li>\n</ul>\n</dd>\n</dl>\n</dd></dl>\n\n</section>\n", "metatags": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n", "rellinks": [["genindex", "General Index", "I", "index"], ["py-modindex", "Python Module Index", "", "modules"], ["telegram/types/chat-admin-rights", "ChatAdminRights", "N", "next"], ["telegram/types/channel-participants-search", "ChannelParticipantsSearch", "P", "previous"]], "sourcename": "", "toc": "<ul>\n<li><a class=\"reference internal\" href=\"#\">Chat</a><ul>\n<li><a class=\"reference internal\" href=\"#pyrogram.raw.types.Chat\"><code class=\"docutils literal notranslate\"><span class=\"pre\">Chat</span></code></a></li>\n</ul>\n</li>\n</ul>\n", "display_toc": true, "page_source_suffix": ".rst", "current_page_name": "telegram/types/chat", "sidebars": ["sidebar/brand.html", "sidebar/search.html", "sidebar/scroll-start.html", "sidebar/navigation.html", "sidebar/scroll-end.html"], "alabaster_version": "1.0.0", "alabaster_version_info": [1, 0, 0], "furo_version": "2025.12.19", "furo_navigation_tree": "", "furo_hide_toc": false, "furo_pygments": {"light": {"background": "#ee