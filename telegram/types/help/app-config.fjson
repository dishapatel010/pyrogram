{"parents": [{"link": "../../", "title": "Raw Types"}, {"link": "../", "title": "Help"}], "prev": {"link": "../", "title": "Help"}, "next": {"link": "../app-config-not-modified/", "title": "help.AppConfigNotModified"}, "title": "help.AppConfig", "meta": null, "body": "<section id=\"help-appconfig\">\n<h1>help.AppConfig<a class=\"headerlink\" href=\"#help-appconfig\" title=\"Link to this heading\">\u00b6</a></h1>\n<dl class=\"py class\">\n<dt class=\"sig sig-object py\" id=\"pyrogram.raw.types.help.AppConfig\">\n<em class=\"property\"><span class=\"pre\">class</span><span class=\"w\"> </span></em><span class=\"sig-prename descclassname\"><span class=\"pre\">pyrogram.raw.types.help.</span></span><span class=\"sig-name descname\"><span class=\"pre\">AppConfig</span></span><a class=\"headerlink\" href=\"#pyrogram.raw.types.help.AppConfig\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Telegram API type.</p>\n<p>Constructor of <a class=\"reference internal\" href=\"../../../base/help/app-config/#pyrogram.raw.base.help.AppConfig\" title=\"pyrogram.raw.base.help.AppConfig\"><code class=\"xref py py-obj docutils literal notranslate\"><span class=\"pre\">AppConfig</span></code></a>.</p>\n<dl class=\"simple\">\n<dt>Details:</dt><dd><ul class=\"simple\">\n<li><p>Layer: <code class=\"docutils literal notranslate\"><span class=\"pre\">222</span></code></p></li>\n<li><p>ID: <code class=\"docutils literal notranslate\"><span class=\"pre\">DD18782E</span></code></p></li>\n</ul>\n</dd>\n</dl>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><ul class=\"simple\">\n<li><p><strong>hash</strong> (<code class=\"docutils literal notranslate\"><span class=\"pre\">int</span></code> <code class=\"docutils literal notranslate\"><span class=\"pre\">32-bit</span></code>) \u2013 N/A</p></li>\n<li><p><strong>config</strong> (<a class=\"reference internal\" href=\"../../../base/json-value/#pyrogram.raw.base.JSONValue\" title=\"pyrogram.raw.base.JSONValue\"><code class=\"xref py py-obj docutils literal notranslate\"><span class=\"pre\">JSONValue</span></code></a>) \u2013 N/A</p></li>\n</ul>\n</dd>\n</dl>\n<dl>\n<dt>Functions:</dt><dd><p>This object can be returned by 1 function.</p>\n<div class=\"table-wrapper autosummary longtable docutils container\">\n<table class=\"autosummary longtable docutils align-default\">\n<tbody>\n<tr class=\"row-odd\"><td><p><a class=\"reference internal\" href=\"../../../functions/help/get-app-config/#pyrogram.raw.functions.help.GetAppConfig\" title=\"pyrogram.raw.functions.help.GetAppConfig\"><code class=\"xref py py-obj docutils literal notranslate\"><span class=\"pre\">help.GetAppConfig</span></code></a></p></td>\n<td><p>Telegram API function.</p></td>\n</tr>\n</tbody>\n</table>\n</div>\n</dd>\n</dl>\n</dd></dl>\n\n</section>\n", "metatags": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n", "rellinks": [["genindex", "General Index", "I", "index"], ["py-modindex", "Python Module Index", "", "modules"], ["telegram/types/help/app-config-not-modified", "help.AppConfigNotModified", "N", "next"], ["telegram/types/help/index", "Help", "P", "previous"]], "sourcename": "", "toc": "<ul>\n<li><a class=\"reference internal\" href=\"#\">help.AppConfig</a><ul>\n<li><a class=\"reference internal\" href=\"#pyrogram.raw.types.help.AppConfig\"><code class=\"docutils literal notranslate\"><span class=\"pre\">AppConfig</span></code></a></li>\n</ul>\n</li>\n</ul>\n", "display_toc": true, "page_source_suffix": ".rst", "current_page_name": "telegram/types/help/app-config", "sidebars": ["sidebar/brand.html", "sidebar/search.html", "sidebar/scroll-start.html", "sidebar/navigation.html", "sidebar/scroll-end.html"], "alabaster_version": "1.0.0", "alabaster_version_info": [1, 0, 0], "furo_version": "2025.12.19", "furo_navigation_tree": "", "furo_hide_toc": false, "furo_pygments": {"light": {"background": "#eeffcc", "foreground": "bl