-obj docutils literal notranslate\"><span class=\"pre\">Photo</span></code></a>, <em>optional</em>) \u2013 N/A</p></li>\n<li><p><strong>ttl_seconds</strong> (<code class=\"docutils literal notranslate\"><span class=\"pre\">int</span></code> <code class=\"docutils literal notranslate\"><span class=\"pre\">32-bit</span></code>, <em>optional</em>) \u2013 N/A</p></li>\n</ul>\n</dd>\n</dl>\n<dl>\n<dt>Functions:</dt><dd><p>This object can be returned by 2 functions.</p>\n<div class=\"table-wrapper autosummary longtable docutils container\">\n<table class=\"autosummary longtable docutils align-default\">\n<tbody>\n<tr class=\"row-odd\"><td><p><a class=\"reference internal\" href=\"../../functions/messages/upload-media/#pyrogram.raw.functions.messages.UploadMedia\" title=\"pyrogram.raw.functions.messages.UploadMedia\"><code class=\"xref py py-obj docutils literal notranslate\"><span class=\"pre\">messages.UploadMedia</span></code></a></p></td>\n<td><p>Telegram API function.</p></td>\n</tr>\n<tr class=\"row-even\"><td><p><a class=\"reference internal\" href=\"../../functions/messages/upload-imported-media/#pyrogram.raw.functions.messages.UploadImportedMedia\" title=\"pyrogram.raw.functions.messages.UploadImportedMedia\"><code class=\"xref py py-obj docutils literal notranslate\"><span class=\"pre\">messages.UploadImportedMedia</span></code></a></p></td>\n<td><p>Telegram API function.</p></td>\n</tr>\n</tbody>\n</table>\n</div>\n</dd>\n</dl>\n</dd></dl>\n\n</section>\n", "metatags": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n", "rellinks": [["genindex", "General Index", "I", "index"], ["py-modindex", "Python Module Index", "", "modules"], ["telegram/types/message-media-poll", "MessageMediaPoll", "N", "next"], ["telegram/types/message-media-paid-media", "MessageMediaPaidMedia", "P", "previous"]], "sourcename": "", "toc": "<ul>\n<li><a class=\"reference internal\" href=\"#\">MessageMediaPhoto</a><ul>\n<li><a class=\"reference internal\" href=\"